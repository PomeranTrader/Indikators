//@version=6
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Pomeranian trader
//
// Gold Greed vs Fear PRO v6 — composite 0–100 sentiment model for XAUUSD, drawn ON the price chart
//   · Macro Link: rolling two-factor regression of gold on DXY and US yields; gold vs macro-implied move = core of the score
//   · score shown as bar colour, background tint, gauge in the dashboard and extreme-zone markers on the bars
//   · linked-market factor panel (DXY, US yields, EURUSD, USDJPY, silver, SPX, VIX …) with sparkline mini charts
//   · 30-day volatility statistics from closed daily bars (no repaint)
//   · Asia / London / New York session statistics, time-of-session excursion profile and a live
//     "range cone" on the price chart: where price typically is 30 min, 1 h, 2 h … after the session open
//
// INŠTALÁCIA: vlož CELÝ súbor (cca 880 riadkov, posledný riadok je "// KONIEC SÚBORU – Gold G/F PRO v6").
// Ak sa vloží iba časť, kompilátor hlási CE10246 alebo sa na grafe zobrazí červené "KÓD JE NEÚPLNÝ".
// Kopíruj z GitHubu cez tlačidlo "Raw", nie z náhľadu v chate (ten sa orezáva pri ~16 000 znakoch).

indicator("Gold Greed vs Fear PRO [Pomeranian]", "Gold G/F PRO", overlay = true, max_lines_count = 100, max_labels_count = 50, max_boxes_count = 50)

// Kontrola úplnosti: upozornenie sa nastaví tu a vymaže až na úplnom konci súboru.
plot(na, "", display = display.none, editable = false)
var table tWarn = table.new(position.middle_center, 1, 1)
if barstate.islast
    table.cell(tWarn, 0, 0, "⚠ KÓD JE NEÚPLNÝ\nDo Pine Editora sa vložila iba časť súboru.\nSkopíruj CELÝ kód z GitHubu (Raw), posledný riadok je\n\"// KONIEC SÚBORU – Gold G/F PRO v6\" a ulož znova.", text_color = color.white, bgcolor = #C62828, text_size = size.large)

//-----------------------------------------------------------------------------}
//Settings
//-----------------------------------------------------------------------------{
//Core
coreG     = "Core components"
rsiLen    = input.int(14,  "RSI Length",           minval = 2,  group = coreG, tooltip = "RSI of the chart symbol, used directly as a 0–100 sub-score.")
fastLen   = input.int(50,  "Fast MA Length",       minval = 5,  group = coreG, tooltip = "Distance of price from this SMA is the short-term stretch sub-score.")
slowLen   = input.int(200, "Slow MA Length",       minval = 20, group = coreG, tooltip = "Distance of price from this SMA is the long-term stretch sub-score.")
atrLen    = input.int(14,  "ATR Length",           minval = 2,  group = coreG, tooltip = "Short ATR used for the volatility regime and for the daily vol scale.")
atrAvgLen = input.int(100, "ATR Baseline Length",  minval = 10, group = coreG, tooltip = "Average of the short ATR. ATR / baseline = volatility excess.")
trendLen  = input.int(20,  "Direction EMA Length", minval = 2,  group = coreG, tooltip = "Price above this EMA = volatility is read as greed, below = fear.")

//Normalization
normG       = "Normalization"
normMode    = input.string("Adaptive (z-score)", "Distance Normalization", options = ["Adaptive (z-score)", "Fixed %"], group = normG,
     tooltip = "Adaptive: distance from MA is z-scored over the lookback. Fixed: a fixed % distance maps to 0 / 100.")
normLen     = input.int(250,    "Z-score Lookback",           minval = 20,   group = normG, tooltip = "Bars used for mean and standard deviation of every z-scored input.")
zCap        = input.float(2.0,  "Z Cap",                      minval = 0.5,  step = 0.1,   group = normG, tooltip = "|z| at which a sub-score saturates at 0 or 100.")
fixFast     = input.float(5.0,  "Fixed: Fast MA %",           minval = 0.1,  step = 0.5,   group = normG, tooltip = "Fixed mode only. % distance from the fast MA that maps to 0 / 100.")
fixSlow     = input.float(12.0, "Fixed: Slow MA %",           minval = 0.1,  step = 0.5,   group = normG, tooltip = "Fixed mode only. % distance from the slow MA that maps to 0 / 100.")
volCap      = input.float(1.8,  "ATR Ratio Cap",              minval = 1.05, step = 0.05,  group = normG, tooltip = "ATR / baseline ratio at which the volatility sub-score saturates.")
volUpFactor = input.float(0.6,  "High Vol In Uptrend Factor", minval = 0.0,  maxval = 1.0, step = 0.05, group = normG, tooltip = "How much of a volatility spike counts as greed when price is above the direction EMA (0 = none, 1 = full).")
calmPts     = input.float(10.0, "Low Vol Drift Points",       minval = 0.0,  maxval = 50.0, group = normG, tooltip = "Max points the volatility sub-score drifts from 50 toward the trend direction when volatility is below baseline.")

//Factors
facG     = "Factor Instruments"
chgLen   = input.int(20,   "Change Lookback",   minval = 1,  group = facG, tooltip = "Bars over which each factor's change is measured, on the chart timeframe.")
useCorr  = input.bool(true, "Correlation Weighting", group = facG, tooltip = "Scale each factor's weight by its live correlation with gold. A factor moving against its expected relationship gets zero weight.")
corrLen  = input.int(60,   "Correlation Length", minval = 10, group = facG, tooltip = "Bars used for the rolling correlation of 1-bar returns.")
sparkLen = input.int(24,   "Mini Chart Length",  minval = 5,  maxval = 60, group = facG, tooltip = "Bars shown in the sparkline mini chart of each factor.")

f1On = input.bool(true,  "", inline = "f1", group = facG)
f1Sym = input.symbol("TVC:DXY",      "", inline = "f1", group = facG)
f1Sign = input.string("Inverse", "", options = ["Inverse", "Direct", "Auto (by corr)"], inline = "f1", group = facG)
f1W = input.float(10.0, "w", minval = 0.0, inline = "f1", group = facG)
f1Unit = input.string("%", "", options = ["%", "pips 0.0001", "pips 0.01", "bp", "pts"], inline = "f1", group = facG,
     tooltip = "Enable · symbol · expected relationship to gold · weight · display unit. Inverse: factor up = gold fear. Direct: factor up = gold greed. Auto: sign of the live correlation.")

f2On = input.bool(true,  "", inline = "f2", group = facG)
f2Sym = input.symbol("TVC:US10Y",    "", inline = "f2", group = facG)
f2Sign = input.string("Inverse", "", options = ["Inverse", "Direct", "Auto (by corr)"], inline = "f2", group = facG)
f2W = input.float(10.0, "w", minval = 0.0, inline = "f2", group = facG)
f2Unit = input.string("bp", "", options = ["%", "pips 0.0001", "pips 0.01", "bp", "pts"], inline = "f2", group = facG)

f3On = input.bool(true,  "", inline = "f3", group = facG)
f3Sym = input.symbol("TVC:US02Y",    "", inline = "f3", group = facG)
f3Sign = input.string("Inverse", "", options = ["Inverse", "Direct", "Auto (by corr)"], inline = "f3", group = facG)
f3W = input.float(5.0,  "w", minval = 0.0, inline = "f3", group = facG)
f3Unit = input.string("bp", "", options = ["%", "pips 0.0001", "pips 0.01", "bp", "pts"], inline = "f3", group = facG)

f4On = input.bool(true,  "", inline = "f4", group = facG)
f4Sym = input.symbol("FX:EURUSD",    "", inline = "f4", group = facG)
f4Sign = input.string("Direct", "", options = ["Inverse", "Direct", "Auto (by corr)"], inline = "f4", group = facG)
f4W = input.float(5.0,  "w", minval = 0.0, inline = "f4", group = facG)
f4Unit = input.string("pips 0.0001", "", options = ["%", "pips 0.0001", "pips 0.01", "bp", "pts"], inline = "f4", group = facG)

f5On = input.bool(true,  "", inline = "f5", group = facG)
f5Sym = input.symbol("FX:USDJPY",    "", inline = "f5", group = facG)
f5Sign = input.string("Inverse", "", options = ["Inverse", "Direct", "Auto (by corr)"], inline = "f5", group = facG)
f5W = input.float(5.0,  "w", minval = 0.0, inline = "f5", group = facG)
f5Unit = input.string("pips 0.01", "", options = ["%", "pips 0.0001", "pips 0.01", "bp", "pts"], inline = "f5", group = facG)

f6On = input.bool(true,  "", inline = "f6", group = facG)
f6Sym = input.symbol("OANDA:XAGUSD", "", inline = "f6", group = facG)
f6Sign = input.string("Direct", "", options = ["Inverse", "Direct", "Auto (by corr)"], inline = "f6", group = facG)
f6W = input.float(5.0,  "w", minval = 0.0, inline = "f6", group = facG)
f6Unit = input.string("%", "", options = ["%", "pips 0.0001", "pips 0.01", "bp", "pts"], inline = "f6", group = facG)

f7On = input.bool(false, "", inline = "f7", group = facG)
f7Sym = input.symbol("SP:SPX",       "", inline = "f7", group = facG)
f7Sign = input.string("Auto (by corr)", "", options = ["Inverse", "Direct", "Auto (by corr)"], inline = "f7", group = facG)
f7W = input.float(5.0,  "w", minval = 0.0, inline = "f7", group = facG)
f7Unit = input.string("%", "", options = ["%", "pips 0.0001", "pips 0.01", "bp", "pts"], inline = "f7", group = facG)

f8On = input.bool(false, "", inline = "f8", group = facG)
f8Sym = input.symbol("TVC:VIX",      "", inline = "f8", group = facG)
f8Sign = input.string("Direct", "", options = ["Inverse", "Direct", "Auto (by corr)"], inline = "f8", group = facG)
f8W = input.float(5.0,  "w", minval = 0.0, inline = "f8", group = facG)
f8Unit = input.string("pts", "", options = ["%", "pips 0.0001", "pips 0.01", "bp", "pts"], inline = "f8", group = facG)

//Macro link
mlG     = "Macro Link (DXY + Bonds)"
mlOn    = input.bool(true, "Enable Macro Link", group = mlG, tooltip = "Rolling two-factor regression of gold returns on DXY returns and yield changes. The macro-implied gold move is compared with the actual move: gold rising although the dollar and yields rise = greed, gold falling although macro is supportive = fear / liquidation.")
mlDxy   = input.symbol("TVC:DXY",   "Dollar", inline = "ml1", group = mlG)
mlYld   = input.symbol("TVC:US10Y", "Yield",  inline = "ml1", group = mlG, tooltip = "Dollar index and yield used in the regression. TVC:US10Y is the nominal 10-year; on a daily chart FRED:DFII10 (real yield) is the better choice.")
betaLen = input.int(120, "Beta Window (bars)",     minval = 30, group = mlG, tooltip = "Bars used to estimate the two betas. Calibrated by simulation: 120 recovers a regime change in the gold / dollar link within about a week on H1.")
resLen  = input.int(60,  "Residual Window (bars)", minval = 5,  group = mlG, tooltip = "Bars over which actual and macro-implied gold moves are summed and compared. Calibrated by simulation: 60 on H1 tracks the rich / cheap level of gold versus macro best.")
wRes    = input.float(35.0, "Weight: Gold vs Macro", minval = 0.0, group = mlG, tooltip = "Weight of the residual sub-score (gold stronger or weaker than DXY and yields imply). Largest single weight in the model by design.")
wTail   = input.float(15.0, "Weight: Macro Tailwind", minval = 0.0, group = mlG, tooltip = "Weight of the macro environment sub-score: falling dollar and falling yields = tailwind for gold.")

//Sentiment
sentG    = "Sentiment"
sentMode = input.string("Off", "Sentiment Mode", options = ["Off", "Blend crowd long %", "Override final score"], group = sentG,
     tooltip = "Blend: the value below enters the weighted average as a sub-score. Override: the value below replaces the final score.")
sentVal0 = input.float(-1.0, "Crowd Long % / Manual Score", minval = -1.0, maxval = 100.0, step = 1.0, group = sentG,
     tooltip = "Paste crowd long % (e.g. Myfxbook XAUUSD long %) or any 0–100 value. -1 = not set.")

//Weights
wG    = "Core Weights"
wRsi  = input.float(30.0, "RSI",          minval = 0.0, group = wG)
wFast = input.float(15.0, "Fast MA Dist", minval = 0.0, group = wG)
wSlow = input.float(15.0, "Slow MA Dist", minval = 0.0, group = wG)
wVol  = input.float(15.0, "ATR Regime",   minval = 0.0, group = wG)
wSent = input.float(15.0, "Sentiment",    minval = 0.0, group = wG, tooltip = "Factor weights are set per factor above. Sub-scores that are not available are dropped from the weighted average.")

//Volatility & sessions
volG     = "Volatility & Sessions"
statLen  = input.int(30,    "Statistics Window",   minval = 5, maxval = 120, group = volG, tooltip = "Number of closed days (daily statistics) and closed sessions (session statistics) in the window.")
volAdj   = input.bool(true, "Vol-adjust Expected Range", group = volG, tooltip = "Multiply the expected excursions by ATR(short) / ATR(window) on daily bars, clamped to 0.5–2.0. The p90 cone is never scaled.")
sliceMin = input.int(30,    "Time Slice (minutes)", minval = 5, maxval = 120, group = volG, tooltip = "Resolution of the time-of-session profile. For every slice the model stores how far price had travelled from the session open; the live cone is built from those slices.")
asiaOn   = input.bool(true, "Asia",     inline = "sA", group = volG)
asiaSess = input.session("0900-1500",  "", inline = "sA", group = volG)
asiaTz   = input.string("Asia/Tokyo",       "", inline = "sA", group = volG)
asiaCol  = input.color(#b388ff, "", inline = "sA", group = volG, tooltip = "Enable · session hours · IANA time zone · color.")
lonOn    = input.bool(true, "London",   inline = "sL", group = volG)
lonSess  = input.session("0800-1630",  "", inline = "sL", group = volG)
lonTz    = input.string("Europe/London",    "", inline = "sL", group = volG)
lonCol   = input.color(#4fc3f7, "", inline = "sL", group = volG)
nyOn     = input.bool(true, "New York", inline = "sN", group = volG)
nySess   = input.session("0830-1700",  "", inline = "sN", group = volG)
nyTz     = input.string("America/New_York", "", inline = "sN", group = volG)
nyCol    = input.color(#ffb74d, "", inline = "sN", group = volG)
showCone = input.bool(true, "Range Cone On Price Chart", group = volG, tooltip = "During a session, draw the expected excursion envelope (open ± typical excursion at the elapsed time × vol scale) and the p90 envelope on the price chart. Past sessions show the cone as it was known then, so you can check the model visually.")
drawProj = input.bool(true, "Open Line, Max Lines & Label", group = volG, tooltip = "At each session open, draw the open line, the max excursion lines of the window and a label with the key numbers.")
keepSess = input.int(3, "Keep Last N Sessions", minval = 1, maxval = 6, group = volG)

//Style
styG      = "Style"
smoothLen = input.int(3, "Smoothing", minval = 1, group = styG, tooltip = "EMA length applied to the final score. 1 = off.")
fearCol   = input.color(#ff4d6d, "Fear",    inline = "col", group = styG)
neutCol   = input.color(#f2c94c, "Neutral", inline = "col", group = styG)
greedCol  = input.color(#3ddc97, "Greed",   inline = "col", group = styG)
scoreMode = input.string("Bars + Background", "Score On Chart", options = ["Bars + Background", "Bars", "Background", "Off"], group = styG,
     tooltip = "How the 0–100 score is shown on the price chart. Bars: candles take the score colour (fear → neutral → greed gradient). Background: a soft tint behind the candles, stronger in the extreme zones.")
bgAlpha   = input.int(90, "Background Transparency", minval = 50, maxval = 98, group = styG)
showShape = input.bool(true, "Extreme Zone Markers", group = styG, tooltip = "Triangle when the score enters an extreme zone, circle when it leaves it. Below the bar for fear, above the bar for greed.")

//Dashboard
dashG    = "Dashboard"
showD1   = input.bool(true, "Components & Factors", inline = "d1", group = dashG)
posD1    = input.string("Top Right", "", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], inline = "d1", group = dashG)
showD2   = input.bool(true, "Volatility & Sessions", inline = "d2", group = dashG)
posD2    = input.string("Top Left", "", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"], inline = "d2", group = dashG)
dashSize = input.string("Small", "Text Size", options = ["Tiny", "Small", "Normal"], group = dashG)
lightBg  = input.bool(false, "Light Chart Background", group = dashG, tooltip = "Switches the dashboard to dark text on a light panel.")
dashAcc  = input.color(#f2c94c, "Accent", group = dashG)

//-----------------------------------------------------------------------------}
//Types
//-----------------------------------------------------------------------------{
type Factor
    bool   on
    string name
    string unit
    string sign
    float  pct
    float  dif
    float  dayPct
    float  corr
    float  score
    float  wEff
    string spark

type Session
    string name
    string tz
    bool   on
    int    mins
    int    startMin
    int    nSlots
    color  col
    array<float>  rng
    array<float>  up
    array<float>  dn
    array<int>    hiSlot
    array<int>    loSlot
    matrix<float> mUp
    matrix<float> mDn
    array<float>  curUp
    array<float>  curDn
    float  o
    float  h
    float  l
    int    startT
    int    hiT
    int    loT
    bool   inS
    bool   first
    bool   ended

//-----------------------------------------------------------------------------}
//Functions
//-----------------------------------------------------------------------------{
dashBg = lightBg ? color.new(#ffffff, 8) : color.new(#11151c, 8)
txtCol = lightBg ? #1e222d : #e6e8ec
txtDim = lightBg ? #6b7280 : #9aa0a6
upCol  = greedCol
dnCol  = fearCol

f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))

f_z(float src, int len) =>
    float m = ta.sma(src, len)
    float s = ta.stdev(src, len)
    na(s) ? na : s > 0 ? (src - m) / s : 0.0

f_zScore(float z) =>
    50.0 + 50.0 * f_clamp(z / zCap, -1.0, 1.0)

f_scoreCol(float x) =>
    na(x) ? neutCol : x < 50 ? color.from_gradient(x, 0, 50, fearCol, neutCol) : color.from_gradient(x, 50, 100, neutCol, greedCol)

f_zoneCol(float x) =>
    na(x) ? neutCol : x < 25 ? fearCol : x < 45 ? color.from_gradient(x, 25, 45, fearCol, neutCol) : x < 55 ? neutCol : x < 75 ? color.from_gradient(x, 55, 75, neutCol, greedCol) : greedCol

f_zoneName(float x) =>
    na(x) ? "–" : x < 25 ? "EXTRÉMNY STRACH" : x < 45 ? "OPATRNOSŤ" : x < 55 ? "NEUTRÁL" : x < 75 ? "CHAMTIVOSŤ" : "EXTRÉMNA CHAMTIVOSŤ"

f_fmt(float x, string f) =>
    na(x) ? "–" : str.tostring(x, f)

f_sgn(float x, string f) =>
    na(x) ? "–" : (x >= 0 ? "+" : "") + str.tostring(x, f)

f_pm(float u, float d) =>
    "+" + f_fmt(u, "0.0") + " / −" + f_fmt(d, "0.0")

f_cov(float a, float b, int n) =>
    ta.correlation(a, b, n) * ta.stdev(a, n) * ta.stdev(b, n)

f_mlText(float zz) =>
    na(zz) ? "–" : zz > 1.5 ? "zlato IGNORUJE makro, silnejšie než implikuje DXY / výnosy" : zz > 0.5 ? "zlato mierne nad tým, čo implikuje makro" :
     zz < -1.5 ? "zlato SLABŠIE než implikuje makro, likvidácia / strach" : zz < -0.5 ? "zlato mierne pod tým, čo implikuje makro" : "v súlade s makrom"

f_gauge(float x) =>
    string g = ""
    if not na(x)
        int k = int(math.round(x / 10.0))
        for i = 1 to 10
            g += i <= k ? "█" : "░"
    g == "" ? "–" : g

f_num(float s, float w) =>
    na(s) or na(w) or w <= 0 ? 0.0 : s * w

f_den(float s, float w) =>
    na(s) or na(w) or w <= 0 ? 0.0 : w

f_name(string sym) =>
    array<string> parts = str.split(sym, ":")
    array.size(parts) > 1 ? array.get(parts, 1) : sym

f_unitMult(string u) =>
    u == "pips 0.0001" ? 10000.0 : u == "pips 0.01" ? 100.0 : u == "bp" ? 100.0 : 1.0

f_unitLbl(string u) =>
    u == "%" ? " %" : u == "bp" ? " bp" : u == "pts" ? " pt" : " pip"

var array<string> blocks = array.from("▁", "▂", "▃", "▄", "▅", "▆", "▇", "█")

f_spark(float src, int n) =>
    float lo = na
    float hi = na
    for i = 0 to n - 1
        float v = src[i]
        if not na(v)
            lo := na(lo) ? v : math.min(lo, v)
            hi := na(hi) ? v : math.max(hi, v)
    string out = ""
    for i = 0 to n - 1
        float v = src[i]
        string ch = "·"
        if not na(v)
            int idx = hi > lo ? int(math.round((v - lo) / (hi - lo) * 7.0)) : 3
            ch := array.get(blocks, idx)
        out := ch + out
    out

f_sessMinutes(string s) =>
    int h1 = int(str.tonumber(str.substring(s, 0, 2)))
    int m1 = int(str.tonumber(str.substring(s, 2, 4)))
    int h2 = int(str.tonumber(str.substring(s, 5, 7)))
    int m2 = int(str.tonumber(str.substring(s, 7, 9)))
    int mins = (h2 * 60 + m2) - (h1 * 60 + m1)
    mins <= 0 ? mins + 1440 : mins

f_sessStartMin(string s) =>
    int(str.tonumber(str.substring(s, 0, 2))) * 60 + int(str.tonumber(str.substring(s, 2, 4)))

f_clock(int totalMin) =>
    int m  = totalMin % 1440
    int hh = int(math.floor(m / 60.0))
    int mm = m % 60
    (hh < 10 ? "0" : "") + str.tostring(hh) + ":" + (mm < 10 ? "0" : "") + str.tostring(mm)

f_dur(int mins) =>
    na(mins) ? "–" : mins < 60 ? str.tostring(mins) + " min" : str.tostring(int(math.floor(mins / 60.0))) + " h " + (mins % 60 < 10 ? "0" : "") + str.tostring(mins % 60)

f_mode(array<int> a, int n) =>
    int best  = -1
    int bestC = 0
    int sz    = array.size(a)
    if sz > 0
        for k = 0 to n - 1
            int c = 0
            for i = 0 to sz - 1
                if array.get(a, i) == k
                    c += 1
            if c > bestC
                bestC := c
                best  := k
    [best, bestC, sz]

f_pos(string p) =>
    p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right :
     p == "Bottom Left" ? position.bottom_left : p == "Middle Right" ? position.middle_right : position.middle_left

f_newSession(string name, bool on, string sess, string tz, color col) =>
    int mins = f_sessMinutes(sess)
    int n    = math.max(1, math.min(96, int(math.ceil(mins * 1.0 / sliceMin))))
    Session.new(name = name, tz = tz, on = on, mins = mins, startMin = f_sessStartMin(sess), nSlots = n, col = col,
     rng = array.new<float>(), up = array.new<float>(), dn = array.new<float>(), hiSlot = array.new<int>(), loSlot = array.new<int>(),
     mUp = matrix.new<float>(0, n), mDn = matrix.new<float>(0, n), curUp = array.new<float>(n), curDn = array.new<float>(n))

//-----------------------------------------------------------------------------}
//Methods
//-----------------------------------------------------------------------------{
method slotAt(Session s, int t) =>
    math.min(s.nSlots - 1, math.max(0, int(math.floor((t - s.startT) / 60000.0 / sliceMin))))

method slotForMinutes(Session s, int minutes) =>
    math.min(s.nSlots - 1, math.max(0, int(math.ceil(minutes * 1.0 / sliceMin)) - 1))

method slotClock(Session s, int k) =>
    f_clock(s.startMin + k * sliceMin) + "–" + f_clock(s.startMin + (k + 1) * sliceMin)

method update(Session s, bool inNow) =>
    bool prev = s.inS
    s.first := inNow and not prev
    s.ended := (not inNow) and prev
    s.inS   := inNow
    if s.first
        s.o      := open
        s.h      := high
        s.l      := low
        s.startT := time
        s.hiT    := time
        s.loT    := time
        array.fill(s.curUp, float(na))
        array.fill(s.curDn, float(na))
    else if inNow
        if high > s.h
            s.h   := high
            s.hiT := time
        if low < s.l
            s.l   := low
            s.loT := time
    if inNow and not na(s.o)
        int   k = s.slotAt(time)
        float u = s.h - s.o
        float d = s.o - s.l
        for j = 0 to k
            if na(array.get(s.curUp, j)) or j == k
                array.set(s.curUp, j, u)
                array.set(s.curDn, j, d)
    if s.ended and not na(s.o)
        float u = s.h - s.o
        float d = s.o - s.l
        for j = 0 to s.nSlots - 1
            if na(array.get(s.curUp, j))
                array.set(s.curUp, j, u)
                array.set(s.curDn, j, d)
        array.push(s.rng, s.h - s.l)
        array.push(s.up,  u)
        array.push(s.dn,  d)
        array.push(s.hiSlot, s.slotAt(s.hiT))
        array.push(s.loSlot, s.slotAt(s.loT))
        matrix.add_row(s.mUp, matrix.rows(s.mUp), array.copy(s.curUp))
        matrix.add_row(s.mDn, matrix.rows(s.mDn), array.copy(s.curDn))
        if array.size(s.rng) > statLen
            array.shift(s.rng)
            array.shift(s.up)
            array.shift(s.dn)
            array.shift(s.hiSlot)
            array.shift(s.loSlot)
            matrix.remove_row(s.mUp, 0)
            matrix.remove_row(s.mDn, 0)
    s

method stats(Session s) =>
    int   n    = array.size(s.rng)
    float mean = n > 0 ? array.avg(s.rng) : na
    float med  = n > 0 ? array.median(s.rng) : na
    float sd   = n > 1 ? array.stdev(s.rng) : na
    float mx   = n > 0 ? array.max(s.rng) : na
    float p90  = n > 0 ? array.percentile_nearest_rank(s.rng, 90) : na
    float mUp  = n > 0 ? array.avg(s.up) : na
    float xUp  = n > 0 ? array.max(s.up) : na
    float mDn  = n > 0 ? array.avg(s.dn) : na
    float xDn  = n > 0 ? array.max(s.dn) : na
    [n, mean, med, sd, mx, p90, mUp, xUp, mDn, xDn]

// Typical excursion from the session open at time slice k: [mean up, p90 up, mean down, p90 down]
method profile(Session s, int k) =>
    int rows = matrix.rows(s.mUp)
    int kk   = nz(k, -1)
    float eU = na
    float pU = na
    float eD = na
    float pD = na
    if rows > 0 and kk >= 0 and kk < s.nSlots
        array<float> cu = matrix.col(s.mUp, kk)
        array<float> cd = matrix.col(s.mDn, kk)
        eU := array.avg(cu)
        pU := array.percentile_nearest_rank(cu, 90)
        eD := array.avg(cd)
        pD := array.percentile_nearest_rank(cd, 90)
    [eU, pU, eD, pD]

method liveRange(Session s) =>
    s.inS ? s.h - s.l : na

method elapsed(Session s) =>
    s.inS ? int(math.floor((time - s.startT) / 60000.0)) : na

var array<line>  projLines  = array.new<line>()
var array<label> projLabels = array.new<label>()

method draw(Session s, float scale) =>
    [n, mean, med, sd, mx, p90, mUp, xUp, mDn, xDn] = s.stats()
    if n > 0
        int x2 = time + s.mins * 60000
        array.push(projLines, line.new(time, s.o, x2, s.o, xloc = xloc.bar_time, color = color.new(s.col, 30), style = line.style_dashed, width = 1))
        array.push(projLines, line.new(time, s.o + xUp, x2, s.o + xUp, xloc = xloc.bar_time, color = color.new(s.col, 20), style = line.style_dotted))
        array.push(projLines, line.new(time, s.o - xDn, x2, s.o - xDn, xloc = xloc.bar_time, color = color.new(s.col, 20), style = line.style_dotted))
        [hk, hc, hn] = f_mode(s.hiSlot, s.nSlots)
        [lk, lc, ln] = f_mode(s.loSlot, s.nSlots)
        string txt = s.name + " · open " + f_fmt(s.o, "0.0") +
             "\nexp " + f_pm(mUp * scale, mDn * scale) + " · range Ø " + f_fmt(mean * scale, "0.0") + " · p90 " + f_fmt(p90, "0.0") +
             "\nmax " + f_pm(xUp, xDn) +
             "\nhigh typ. " + (hk >= 0 ? s.slotClock(hk) : "–") + " · low typ. " + (lk >= 0 ? s.slotClock(lk) : "–")
        array.push(projLabels, label.new(x2, s.o + xUp, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(s.col, 55), textcolor = lightBg ? #1e222d : #ffffff, size = size.small, textalign = text.align_left))
        while array.size(projLines) > keepSess * 9
            line.delete(array.shift(projLines))
        while array.size(projLabels) > keepSess * 3
            label.delete(array.shift(projLabels))
    s

//-----------------------------------------------------------------------------}
//Core components
//-----------------------------------------------------------------------------{
rsiVal = ta.rsi(close, rsiLen)
sRsi   = rsiVal

smaF     = ta.sma(close, fastLen)
smaS     = ta.sma(close, slowLen)
dFast    = (close - smaF) / smaF * 100.0
dSlow    = (close - smaS) / smaS * 100.0
adaptive = normMode == "Adaptive (z-score)"
sFast    = adaptive ? f_zScore(f_z(dFast, normLen)) : na(dFast) ? na : 50.0 + 50.0 * f_clamp(dFast / fixFast, -1.0, 1.0)
sSlow    = adaptive ? f_zScore(f_z(dSlow, normLen)) : na(dSlow) ? na : 50.0 + 50.0 * f_clamp(dSlow / fixSlow, -1.0, 1.0)

atrVal    = ta.atr(atrLen)
atrAvg    = ta.sma(atrVal, atrAvgLen)
atrRatio  = atrVal / atrAvg
upTrend   = close >= ta.ema(close, trendLen)
volExcess = f_clamp((atrRatio - 1.0) / (volCap - 1.0), -1.0, 1.0)
sVol = na(volExcess) ? na :
     volExcess >= 0 ? (upTrend ? 50.0 + 50.0 * volExcess * volUpFactor : 50.0 - 50.0 * volExcess) :
     50.0 + calmPts * (-volExcess) * (upTrend ? 1.0 : -1.0)

goldRet = ta.roc(close, 1)

//-----------------------------------------------------------------------------}
//Macro link: gold = bD · DXY return + bY · yield change (bp) + residual
//-----------------------------------------------------------------------------{
mlD   = request.security(mlDxy, timeframe.period, close, lookahead = barmerge.lookahead_off)
mlY   = request.security(mlYld, timeframe.period, close, lookahead = barmerge.lookahead_off)
rD    = ta.roc(mlD, 1)
dYbp  = ta.change(mlY) * 100.0
c11   = ta.variance(rD, betaLen)
c22   = ta.variance(dYbp, betaLen)
c12   = f_cov(rD, dYbp, betaLen)
cy1   = f_cov(goldRet, rD, betaLen)
cy2   = f_cov(goldRet, dYbp, betaLen)
det   = c11 * c22 - c12 * c12
bD    = na(det) or det == 0 ? na : (cy1 * c22 - cy2 * c12) / det
bY    = na(det) or det == 0 ? na : (cy2 * c11 - cy1 * c12) / det
implied = bD * rD + bY * dYbp
resid   = goldRet - implied
cumRes  = math.sum(resid, resLen)
cumAct  = math.sum(goldRet, resLen)
cumImp  = math.sum(implied, resLen)
zRes    = f_z(cumRes, normLen)
sRes    = mlOn ? f_zScore(zRes) : na
dxyChg  = ta.roc(mlD, resLen)
yldChg  = ta.change(mlY, resLen) * 100.0
zTail   = -(f_z(dxyChg, normLen) + f_z(yldChg, normLen)) / 2.0
sTail   = mlOn ? f_zScore(zTail) : na
resSp   = f_spark(cumRes, sparkLen)

//-----------------------------------------------------------------------------}
//Factors
//-----------------------------------------------------------------------------{
f_factor(bool on, simple string sym, string sign, float w, string unit) =>
    float px = request.security(sym, timeframe.period, close, lookahead = barmerge.lookahead_off)
    [dO, dC] = request.security(sym, "D", [open, close], lookahead = barmerge.lookahead_off)
    float pct = ta.roc(px, chgLen)
    float dif = ta.change(px, chgLen)
    float r   = ta.correlation(goldRet, ta.roc(px, 1), corrLen)
    float z   = f_z(unit == "bp" ? dif : pct, normLen)
    float e   = sign == "Direct" ? 1.0 : sign == "Inverse" ? -1.0 : nz(r) >= 0 ? 1.0 : -1.0
    float sc  = na(z) ? na : e > 0 ? f_zScore(z) : 100.0 - f_zScore(z)
    float al  = sign == "Auto (by corr)" ? math.abs(nz(r)) : math.max(0.0, e * nz(r))
    float wE  = useCorr ? w * al : w
    Factor.new(on, f_name(sym), unit, sign, pct, dif, (dC - dO) / dO * 100.0, r, on ? sc : na, on ? wE : 0.0, f_spark(px, sparkLen))

Factor fc1 = f_factor(f1On, f1Sym, f1Sign, f1W, f1Unit)
Factor fc2 = f_factor(f2On, f2Sym, f2Sign, f2W, f2Unit)
Factor fc3 = f_factor(f3On, f3Sym, f3Sign, f3W, f3Unit)
Factor fc4 = f_factor(f4On, f4Sym, f4Sign, f4W, f4Unit)
Factor fc5 = f_factor(f5On, f5Sym, f5Sign, f5W, f5Unit)
Factor fc6 = f_factor(f6On, f6Sym, f6Sign, f6W, f6Unit)
Factor fc7 = f_factor(f7On, f7Sym, f7Sign, f7W, f7Unit)
Factor fc8 = f_factor(f8On, f8Sym, f8Sign, f8W, f8Unit)

f_bias(Factor f) =>
    not f.on or na(f.score) ? 0 : f.score >= 55 ? 1 : f.score <= 45 ? -1 : 0

facGreed = (f_bias(fc1) == 1 ? 1 : 0) + (f_bias(fc2) == 1 ? 1 : 0) + (f_bias(fc3) == 1 ? 1 : 0) + (f_bias(fc4) == 1 ? 1 : 0) +
     (f_bias(fc5) == 1 ? 1 : 0) + (f_bias(fc6) == 1 ? 1 : 0) + (f_bias(fc7) == 1 ? 1 : 0) + (f_bias(fc8) == 1 ? 1 : 0)
facFear  = (f_bias(fc1) == -1 ? 1 : 0) + (f_bias(fc2) == -1 ? 1 : 0) + (f_bias(fc3) == -1 ? 1 : 0) + (f_bias(fc4) == -1 ? 1 : 0) +
     (f_bias(fc5) == -1 ? 1 : 0) + (f_bias(fc6) == -1 ? 1 : 0) + (f_bias(fc7) == -1 ? 1 : 0) + (f_bias(fc8) == -1 ? 1 : 0)
facOn    = (f1On ? 1 : 0) + (f2On ? 1 : 0) + (f3On ? 1 : 0) + (f4On ? 1 : 0) + (f5On ? 1 : 0) + (f6On ? 1 : 0) + (f7On ? 1 : 0) + (f8On ? 1 : 0)

//-----------------------------------------------------------------------------}
//Score
//-----------------------------------------------------------------------------{
sentVal    = sentVal0 < 0 ? na : sentVal0
sSent      = sentMode == "Blend crowd long %" ? sentVal : na
isOverride = sentMode == "Override final score" and not na(sentVal)

num = f_num(sRsi, wRsi) + f_num(sFast, wFast) + f_num(sSlow, wSlow) + f_num(sVol, wVol) + f_num(sSent, wSent) + f_num(sRes, wRes) + f_num(sTail, wTail) +
     f_num(fc1.score, fc1.wEff) + f_num(fc2.score, fc2.wEff) + f_num(fc3.score, fc3.wEff) + f_num(fc4.score, fc4.wEff) +
     f_num(fc5.score, fc5.wEff) + f_num(fc6.score, fc6.wEff) + f_num(fc7.score, fc7.wEff) + f_num(fc8.score, fc8.wEff)
den = f_den(sRsi, wRsi) + f_den(sFast, wFast) + f_den(sSlow, wSlow) + f_den(sVol, wVol) + f_den(sSent, wSent) + f_den(sRes, wRes) + f_den(sTail, wTail) +
     f_den(fc1.score, fc1.wEff) + f_den(fc2.score, fc2.wEff) + f_den(fc3.score, fc3.wEff) + f_den(fc4.score, fc4.wEff) +
     f_den(fc5.score, fc5.wEff) + f_den(fc6.score, fc6.wEff) + f_den(fc7.score, fc7.wEff) + f_den(fc8.score, fc8.wEff)

raw      = den > 0 ? num / den : na
smoothed = ta.ema(raw, smoothLen)
score    = isOverride ? sentVal : smoothed
scoreSp  = f_spark(score, sparkLen)
scoreCol = f_scoreCol(score)

//-----------------------------------------------------------------------------}
//Daily volatility statistics (closed days only)
//-----------------------------------------------------------------------------{
dRng = high - low
dRet = math.log(close / close[1])
[adr, adrMed, adrSd, adrMax, rvol, atrD, atrDW] = request.security(syminfo.tickerid, "D",
     [ta.sma(dRng, statLen)[1], ta.percentile_nearest_rank(dRng, statLen, 50)[1], ta.stdev(dRng, statLen)[1],
     ta.highest(dRng, statLen)[1], ta.stdev(dRet, statLen)[1], ta.atr(atrLen)[1], ta.atr(statLen)[1]],
     lookahead = barmerge.lookahead_on)
[dHighT, dLowT] = request.security(syminfo.tickerid, "D", [high, low], lookahead = barmerge.lookahead_off)

volScale = volAdj and not na(atrD) and not na(atrDW) and atrDW > 0 ? f_clamp(atrD / atrDW, 0.5, 2.0) : 1.0
expDay   = adr * volScale
sigmaUsd = close * rvol
rvolAnn  = rvol * math.sqrt(252) * 100.0
todayRng = dHighT - dLowT
todayPct = todayRng / adr * 100.0

//-----------------------------------------------------------------------------}
//Sessions
//-----------------------------------------------------------------------------{
var Session asia = f_newSession("Asia",     asiaOn, asiaSess, asiaTz, asiaCol)
var Session lon  = f_newSession("London",   lonOn,  lonSess,  lonTz,  lonCol)
var Session ny   = f_newSession("New York", nyOn,   nySess,   nyTz,   nyCol)
var Session none = f_newSession("–",        false,  "0000-0001", "UTC", neutCol)

intraday = timeframe.isintraday
inAsia   = asiaOn and intraday and not na(time(timeframe.period, asiaSess, asiaTz))
inLon    = lonOn  and intraday and not na(time(timeframe.period, lonSess,  lonTz))
inNy     = nyOn   and intraday and not na(time(timeframe.period, nySess,   nyTz))

asia.update(inAsia)
lon.update(inLon)
ny.update(inNy)

curId = ny.inS ? 2 : lon.inS ? 1 : asia.inS ? 0 : -1
var int lastEnded = -1
if asia.ended
    lastEnded := 0
if lon.ended
    lastEnded := 1
if ny.ended
    lastEnded := 2

f_sess(int id) =>
    id == 0 ? asia : id == 1 ? lon : id == 2 ? ny : none

f_next(int from) =>
    int res = -1
    int c   = from < 0 ? 2 : from
    for k = 1 to 3
        c := (c + 1) % 3
        if res < 0 and f_sess(c).on
            res := c
    res

nextId = f_next(curId >= 0 ? curId : lastEnded)
Session cur = f_sess(curId)
Session nxt = f_sess(nextId)

[nxN, nxMean, nxMed, nxSd, nxMax, nxP90, nxMUp, nxXUp, nxMDn, nxXDn] = nxt.stats()
[cuN, cuMean, cuMed, cuSd, cuMax, cuP90, cuMUp, cuXUp, cuMDn, cuXDn] = cur.stats()

nxExp   = nxMean * volScale
nxUp    = nxMUp * volScale
nxDn    = nxMDn * volScale
curRng  = cur.liveRange()
curExp  = cuMean * volScale
curUsed = curRng / curExp * 100.0
curEl   = cur.elapsed()
exceed  = curId >= 0 and not na(curExp) and curRng > curExp
exceedP = curId >= 0 and not na(cuP90) and curRng > cuP90

// Live cone: typical and p90 excursion from the session open at the elapsed time slice
liveK = curId >= 0 ? cur.slotAt(time) : -1
[kU, kPU, kD, kPD] = cur.profile(liveK)
coneOn  = showCone and curId >= 0 and not na(kU)
coneHi  = coneOn ? cur.o + kU * volScale : na
coneLo  = coneOn ? cur.o - kD * volScale : na
coneHi9 = coneOn ? cur.o + kPU : na
coneLo9 = coneOn ? cur.o - kPD : na
coneCol = curId >= 0 ? cur.col : neutCol

if drawProj and intraday
    if asia.first
        asia.draw(volScale)
    if lon.first
        lon.draw(volScale)
    if ny.first
        ny.draw(volScale)

//-----------------------------------------------------------------------------}
//Plots (everything on the price chart)
//-----------------------------------------------------------------------------{
showBars = scoreMode == "Bars + Background" or scoreMode == "Bars"
showBgS  = scoreMode == "Bars + Background" or scoreMode == "Background"
extreme  = score < 25 or score > 75

barcolor(showBars ? scoreCol : na, title = "Score bar colour")
bgcolor(showBgS and not na(score) ? color.new(scoreCol, extreme ? bgAlpha - 10 : bgAlpha) : na, title = "Score background")

plot(score, "Greed / Fear score", display = display.data_window)
plot(sRsi,  "RSI sub-score",     display = display.data_window)
plot(sFast, "Fast MA sub-score", display = display.data_window)
plot(sSlow, "Slow MA sub-score", display = display.data_window)
plot(sVol,  "ATR sub-score",     display = display.data_window)
plot(sRes,  "Gold vs macro sub-score", display = display.data_window)
plot(sTail, "Macro tailwind sub-score", display = display.data_window)
plot(cumRes, "Gold vs macro residual %", display = display.data_window)
plot(fc1.score, "Factor 1 sub-score", display = display.data_window)
plot(fc2.score, "Factor 2 sub-score", display = display.data_window)
plot(fc3.score, "Factor 3 sub-score", display = display.data_window)
plot(fc4.score, "Factor 4 sub-score", display = display.data_window)
plot(fc5.score, "Factor 5 sub-score", display = display.data_window)
plot(fc6.score, "Factor 6 sub-score", display = display.data_window)
plot(fc7.score, "Factor 7 sub-score", display = display.data_window)
plot(fc8.score, "Factor 8 sub-score", display = display.data_window)
plot(nxExp,  "Next session expected range", display = display.data_window)
plot(curRng, "Current session range",       display = display.data_window)

// Range cone
pCH  = plot(coneHi,  "Cone expected high", color.new(coneCol, 0),  2, plot.style_linebr)
pCL  = plot(coneLo,  "Cone expected low",  color.new(coneCol, 0),  2, plot.style_linebr)
pCH9 = plot(coneHi9, "Cone p90 high",      color.new(coneCol, 45), 1, plot.style_linebr)
pCL9 = plot(coneLo9, "Cone p90 low",       color.new(coneCol, 45), 1, plot.style_linebr)
fill(pCH, pCL,   color = color.new(coneCol, 82), title = "Cone expected")
fill(pCH9, pCH,  color = color.new(coneCol, 93), title = "Cone p90 upper")
fill(pCL, pCL9,  color = color.new(coneCol, 93), title = "Cone p90 lower")

xFearIn   = ta.crossunder(score, 25)
xFearOut  = ta.crossover(score, 25)
xGreedIn  = ta.crossover(score, 75)
xGreedOut = ta.crossunder(score, 75)

plotshape(showShape and xFearIn,   "Enter Extreme Fear",  shape.triangleup,   location.belowbar, fearCol,  size = size.small)
plotshape(showShape and xFearOut,  "Exit Extreme Fear",   shape.circle,       location.belowbar, fearCol,  size = size.tiny)
plotshape(showShape and xGreedIn,  "Enter Extreme Greed", shape.triangledown, location.abovebar, greedCol, size = size.small)
plotshape(showShape and xGreedOut, "Exit Extreme Greed",  shape.circle,       location.abovebar, greedCol, size = size.tiny)

//-----------------------------------------------------------------------------}
//Alerts
//-----------------------------------------------------------------------------{
alertcondition(xFearIn,     "Extreme Fear (cross)",   "Gold G/F: score crossed below 25 on {{ticker}} {{interval}} · score {{plot(\"Greed / Fear score\")}}")
alertcondition(xGreedIn,    "Extreme Greed (cross)",  "Gold G/F: score crossed above 75 on {{ticker}} {{interval}} · score {{plot(\"Greed / Fear score\")}}")
alertcondition(score < 25,  "Extreme Fear (state)",   "Gold G/F: score below 25 on {{ticker}} {{interval}}")
alertcondition(score > 75,  "Extreme Greed (state)",  "Gold G/F: score above 75 on {{ticker}} {{interval}}")
alertcondition(xFearOut or xGreedOut, "Exit extreme zone", "Gold G/F: score left an extreme zone on {{ticker}} {{interval}}")
alertcondition(exceed and not exceed[1],   "Session range > expected", "Gold G/F: session range exceeded the vol-adjusted expected range on {{ticker}} {{interval}}")
alertcondition(exceedP and not exceedP[1], "Session range > p90",      "Gold G/F: session range exceeded the p90 of the window on {{ticker}} {{interval}}")
alertcondition(ta.crossover(zRes, 2.0),   "Gold far above macro",  "Gold G/F: gold is running far above what DXY and yields imply on {{ticker}} {{interval}} (residual z > 2)")
alertcondition(ta.crossunder(zRes, -2.0), "Gold far below macro",  "Gold G/F: gold is far below what DXY and yields imply on {{ticker}} {{interval}} (residual z < -2)")
coneBreakUp = coneOn and close > coneHi9
coneBreakDn = coneOn and close < coneLo9
alertcondition(coneBreakUp and not coneBreakUp[1], "Price above p90 cone", "Gold G/F: price moved above the p90 cone of the session on {{ticker}} {{interval}}")
alertcondition(coneBreakDn and not coneBreakDn[1], "Price below p90 cone", "Gold G/F: price moved below the p90 cone of the session on {{ticker}} {{interval}}")

//-----------------------------------------------------------------------------}
//Dashboard
//-----------------------------------------------------------------------------{
tsz = dashSize == "Tiny" ? size.tiny : dashSize == "Normal" ? size.normal : size.small

var table d1 = table.new(f_pos(posD1), 6, 18, bgcolor = dashBg, frame_color = color.new(dashAcc, 50), frame_width = 1, border_color = color.new(txtCol, 88), border_width = 1)
var table d2 = table.new(f_pos(posD2), 3, 29, bgcolor = dashBg, frame_color = color.new(dashAcc, 50), frame_width = 1, border_color = color.new(txtCol, 88), border_width = 1)

f_cell(table t, int c, int r, string s, color tc, color bg, string al) =>
    table.cell(t, c, r, s, text_color = tc, text_size = tsz, bgcolor = bg, text_halign = al)

f_head(table t, int r, string a, string b, string c, string d, string e, string f) =>
    color bg = color.new(dashAcc, 78)
    f_cell(t, 0, r, a, dashAcc, bg, text.align_left)
    f_cell(t, 1, r, b, txtCol, bg, text.align_left)
    f_cell(t, 2, r, c, txtCol, bg, text.align_right)
    f_cell(t, 3, r, d, txtCol, bg, text.align_right)
    f_cell(t, 4, r, e, txtCol, bg, text.align_right)
    f_cell(t, 5, r, f, txtCol, bg, text.align_center)

f_core(int r, string name, string val, float s) =>
    f_cell(d1, 0, r, name, txtCol, color(na), text.align_left)
    f_cell(d1, 1, r, "", txtCol, color(na), text.align_left)
    f_cell(d1, 2, r, val, txtCol, color(na), text.align_right)
    f_cell(d1, 3, r, "", txtCol, color(na), text.align_right)
    f_cell(d1, 4, r, "", txtCol, color(na), text.align_right)
    f_cell(d1, 5, r, f_fmt(s, "0"), color.white, na(s) ? color(na) : color.new(f_zoneCol(s), 35), text.align_center)

method row(Factor f, int r) =>
    string arrow = f.sign == "Direct" ? "↑" : f.sign == "Inverse" ? "↓" : "⇅"
    string chg   = f.unit == "%" ? f_sgn(f.pct, "0.00") + " %" : f_sgn(f.dif * f_unitMult(f.unit), "0.0") + f_unitLbl(f.unit) + "  (" + f_sgn(f.pct, "0.00") + " %)"
    color  tc    = not f.on ? txtDim : na(f.pct) ? txtCol : f.pct >= 0 ? upCol : dnCol
    color  dc    = not f.on or na(f.dayPct) ? txtDim : f.dayPct >= 0 ? upCol : dnCol
    f_cell(d1, 0, r, f.name + " " + arrow, f.on ? txtCol : txtDim, color(na), text.align_left)
    f_cell(d1, 1, r, f.on ? f.spark : "off", tc, color(na), text.align_left)
    f_cell(d1, 2, r, f.on ? chg : "–", tc, color(na), text.align_right)
    f_cell(d1, 3, r, f.on ? f_sgn(f.dayPct, "0.00") + " %" : "–", dc, color(na), text.align_right)
    f_cell(d1, 4, r, f.on ? "r " + f_fmt(f.corr, "0.00") + " · w " + f_fmt(f.wEff, "0.0") : "–", txtDim, color(na), text.align_right)
    f_cell(d1, 5, r, f.on ? f_fmt(f.score, "0") : "–", color.white, f.on and not na(f.score) ? color.new(f_zoneCol(f.score), 35) : color(na), text.align_center)

f_vrow(int r, string a, string b, string c, color ca) =>
    f_cell(d2, 0, r, a, ca, color(na), text.align_left)
    f_cell(d2, 1, r, b, txtCol, color(na), text.align_right)
    f_cell(d2, 2, r, c, txtDim, color(na), text.align_left)

f_vhead(int r, string a, string b, string c) =>
    color bg = color.new(dashAcc, 78)
    f_cell(d2, 0, r, a, dashAcc, bg, text.align_left)
    f_cell(d2, 1, r, b, txtCol, bg, text.align_right)
    f_cell(d2, 2, r, c, txtCol, bg, text.align_left)

method srow(Session s, int r) =>
    [n, mean, med, sd, mx, p90, mUp, xUp, mDn, xDn] = s.stats()
    string a = s.name + (s.on ? " (" + str.tostring(n) + ")" : " off")
    string b = s.on and n > 0 ? "Ø " + f_fmt(mean, "0.0") + " · md " + f_fmt(med, "0.0") + " · p90 " + f_fmt(p90, "0.0") + " · max " + f_fmt(mx, "0.0") : "–"
    string c = s.on and n > 0 ? "↑ Ø " + f_fmt(mUp, "0.0") + " / max " + f_fmt(xUp, "0.0") + "   ↓ Ø " + f_fmt(mDn, "0.0") + " / max " + f_fmt(xDn, "0.0") : "–"
    f_cell(d2, 0, r, a, s.on ? s.col : txtDim, color(na), text.align_left)
    f_cell(d2, 1, r, b, txtCol, color(na), text.align_right)
    f_cell(d2, 2, r, c, txtDim, color(na), text.align_left)

// Path in time: typical and p90 excursion from the open of session s after `minutes`
method prow(Session s, int r, int minutes, float scale, float ref) =>
    int mins = math.min(minutes, s.mins)
    [eU, pU, eD, pD] = s.profile(s.slotForMinutes(mins))
    string a = (mins == s.mins ? "koniec (" : "+ ") + f_dur(mins) + (mins == s.mins ? ")" : "")
    string b = na(eU) ? "–" : f_pm(eU * scale, eD * scale) + " $"
    string c = na(eU) ? "–" : "hi " + f_fmt(ref + eU * scale, "0.0") + " / lo " + f_fmt(ref - eD * scale, "0.0") + "   p90 " + f_pm(pU, pD)
    f_vrow(r, a, b, c, txtCol)

isGold = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD") or str.startswith(syminfo.ticker, "GC")

if showD1 and barstate.islast
    f_head(d1, 0, "Gold G/F PRO", "Mini graf (" + str.tostring(sparkLen) + " b)", "Δ " + str.tostring(chgLen) + " b", "Dnes", "0 ░░░░░░░░░░ 100 · r · váha", "Skóre")
    f_cell(d1, 0, 1, "SKÓRE", txtCol, color(na), text.align_left)
    f_cell(d1, 1, 1, scoreSp, scoreCol, color(na), text.align_left)
    f_cell(d1, 2, 1, isOverride ? f_zoneName(score) + " (manual)" : f_zoneName(score), scoreCol, color(na), text.align_right)
    f_cell(d1, 3, 1, f_sgn(score - score[1], "0.0"), txtDim, color(na), text.align_right)
    f_cell(d1, 4, 1, f_gauge(score) + "  Σw " + f_fmt(den, "0"), scoreCol, color(na), text.align_right)
    f_cell(d1, 5, 1, f_fmt(score, "0.0"), #11151c, scoreCol, text.align_center)
    f_core(2, "RSI(" + str.tostring(rsiLen) + ")",  f_fmt(rsiVal, "0.0"), sRsi)
    f_core(3, "Dist SMA" + str.tostring(fastLen),   f_sgn(dFast, "0.00") + " %", sFast)
    f_core(4, "Dist SMA" + str.tostring(slowLen),   f_sgn(dSlow, "0.00") + " %", sSlow)
    f_core(5, "ATR režim " + (upTrend ? "↑" : "↓"), f_fmt(atrRatio, "0.00") + "x", sVol)
    f_core(6, "Sentiment", sentMode == "Off" ? "off" : na(sentVal) ? "na" : f_fmt(sentVal, "0") + (isOverride ? " (override)" : " % long"), sSent)
    color resCol = not mlOn or na(cumRes) ? txtDim : cumRes >= 0 ? upCol : dnCol
    f_cell(d1, 0, 7, "Zlato vs makro (" + str.tostring(resLen) + " b)", mlOn ? txtCol : txtDim, color(na), text.align_left)
    f_cell(d1, 1, 7, mlOn ? resSp : "off", resCol, color(na), text.align_left)
    f_cell(d1, 2, 7, mlOn ? "skut. " + f_sgn(cumAct, "0.00") + " % · impl. " + f_sgn(cumImp, "0.00") + " %" : "–", txtCol, color(na), text.align_right)
    f_cell(d1, 3, 7, mlOn ? "rez. " + f_sgn(cumRes, "0.00") + " %" : "–", resCol, color(na), text.align_right)
    f_cell(d1, 4, 7, mlOn ? "βDXY " + f_fmt(bD, "0.00") + " · β10Y " + f_fmt(bY * 100.0, "0.00") + " %/bp·100 · w " + f_fmt(wRes, "0") : "–", txtDim, color(na), text.align_right)
    f_cell(d1, 5, 7, mlOn ? f_fmt(sRes, "0") : "–", color.white, mlOn and not na(sRes) ? color.new(f_zoneCol(sRes), 35) : color(na), text.align_center)
    f_cell(d1, 0, 8, "Makro tailwind", mlOn ? txtCol : txtDim, color(na), text.align_left)
    f_cell(d1, 1, 8, mlOn ? f_mlText(zRes) : "off", txtDim, color(na), text.align_left)
    f_cell(d1, 2, 8, mlOn ? "DXY " + f_sgn(dxyChg, "0.00") + " %" : "–", mlOn and not na(dxyChg) ? (dxyChg <= 0 ? upCol : dnCol) : txtDim, color(na), text.align_right)
    f_cell(d1, 3, 8, mlOn ? "10Y " + f_sgn(yldChg, "0") + " bp" : "–", mlOn and not na(yldChg) ? (yldChg <= 0 ? upCol : dnCol) : txtDim, color(na), text.align_right)
    f_cell(d1, 4, 8, mlOn ? "z " + f_sgn(zTail, "0.00") + " · w " + f_fmt(wTail, "0") : "–", txtDim, color(na), text.align_right)
    f_cell(d1, 5, 8, mlOn ? f_fmt(sTail, "0") : "–", color.white, mlOn and not na(sTail) ? color.new(f_zoneCol(sTail), 35) : color(na), text.align_center)
    fc1.row(9)
    fc2.row(10)
    fc3.row(11)
    fc4.row(12)
    fc5.row(13)
    fc6.row(14)
    fc7.row(15)
    fc8.row(16)
    f_cell(d1, 0, 17, "Faktory", txtDim, color(na), text.align_left)
    f_cell(d1, 1, 17, str.tostring(facGreed) + " ↑ greed · " + str.tostring(facFear) + " ↓ fear · " + str.tostring(facOn - facGreed - facFear) + " → neutrál", txtCol, color(na), text.align_left)
    f_cell(d1, 2, 17, "", txtCol, color(na), text.align_right)
    f_cell(d1, 3, 17, "", txtCol, color(na), text.align_right)
    f_cell(d1, 4, 17, isGold ? "" : "⚠ graf nie je zlato", color.orange, color(na), text.align_right)
    f_cell(d1, 5, 17, "", txtCol, color(na), text.align_center)

if showD2 and barstate.islast
    [hk, hc, hn] = f_mode(nxt.hiSlot, nxt.nSlots)
    [lk, lc, ln] = f_mode(nxt.loSlot, nxt.nSlots)
    [chk, chc, chn] = f_mode(cur.hiSlot, cur.nSlots)
    [clk, clc, cln] = f_mode(cur.loSlot, cur.nSlots)
    float remExp = math.max(0.0, curExp - curRng)
    f_vhead(0, "VOLATILITA " + str.tostring(statLen) + " D", "Hodnota", "Poznámka")
    f_vrow(1, "ADR priemer",      f_fmt(adr, "0.0") + " $",          "medián " + f_fmt(adrMed, "0.0") + " · σ " + f_fmt(adrSd, "0.0") + " · max " + f_fmt(adrMax, "0.0"), txtCol)
    f_vrow(2, "Realizovaná vol",  f_fmt(rvolAnn, "0.0") + " % p.a.", "1σ deň ≈ " + f_fmt(sigmaUsd, "0.0") + " $ (" + f_fmt(rvol * 100.0, "0.00") + " %)", txtCol)
    f_vrow(3, "Dnešný range",     f_fmt(todayRng, "0.0") + " $",     f_fmt(todayPct, "0") + " % ADR", todayPct > 100 ? color.orange : txtCol)
    f_vrow(4, "Vol scale",        f_fmt(volScale, "0.00") + "x",     "ATR" + str.tostring(atrLen) + " / ATR" + str.tostring(statLen) + " denné" + (volAdj ? "" : " · vypnuté"), volScale > 1.2 ? color.orange : volScale < 0.8 ? lonCol : txtCol)
    f_vrow(5, "Oč. denný range",  f_fmt(expDay, "0.0") + " $",       "± " + f_fmt(adrSd, "0.0") + " · od close: " + f_fmt(close + expDay / 2, "0.0") + " / " + f_fmt(close - expDay / 2, "0.0"), txtCol)
    f_vhead(6, "SEANSY (posl. " + str.tostring(statLen) + ")", "range $: Ø · medián · p90 · max", "odchýlky od open $")
    asia.srow(7)
    lon.srow(8)
    ny.srow(9)
    f_vhead(10, "AKTUÁLNA SEANSA", curId >= 0 ? cur.name + " · " + f_dur(curEl) : "mimo seansy", intraday ? (curId >= 0 ? "open " + f_fmt(cur.o, "0.0") : "") : "seansy len na intraday grafe")
    f_vrow(11, "Range zatiaľ", curId >= 0 ? f_fmt(curRng, "0.0") + " $ (" + f_fmt(curUsed, "0") + " %)" : "–", curId >= 0 ? "z očakávaných " + f_fmt(curExp, "0.0") + " · zostáva typicky " + f_fmt(remExp, "0.0") + " $" : "–", exceedP ? fearCol : exceed ? color.orange : txtCol)
    f_vrow(12, "Teraz typicky", curId >= 0 and not na(kU) ? f_pm(kU * volScale, kD * volScale) + " $" : "–", curId >= 0 ? "máme " + f_pm(cur.h - cur.o, cur.o - cur.l) + " · p90 " + f_pm(kPU, kPD) : "–", txtCol)
    f_vrow(13, "Typický čas high / low", curId >= 0 and chk >= 0 ? cur.slotClock(chk) : "–", curId >= 0 and clk >= 0 ? "low " + cur.slotClock(clk) + " (" + cur.tz + ", " + str.tostring(chc) + "+" + str.tostring(clc) + " z " + str.tostring(chn) + ")" : "–", txtCol)
    f_vhead(14, "ĎALŠIA SEANSA", nxt.name, nxN > 0 ? "n = " + str.tostring(nxN) + " · " + f_clock(nxt.startMin) + " " + nxt.tz : "bez dát")
    f_vrow(15, "Oč. range",       f_fmt(nxExp, "0.0") + " $", "± σ " + f_fmt(nxSd, "0.0") + " · medián " + f_fmt(nxMed, "0.0") + " · p90 " + f_fmt(nxP90, "0.0") + " · max " + f_fmt(nxMax, "0.0"), txtCol)
    f_vrow(16, "Oč. high / low",  f_fmt(close + nxUp, "0.0") + " / " + f_fmt(close - nxDn, "0.0"), "od aktuálnej ceny " + f_pm(nxUp, nxDn) + " $", txtCol)
    f_vrow(17, "Max odchýlka",    f_pm(nxXUp, nxXDn) + " $", "high " + f_fmt(close + nxXUp, "0.0") + " / low " + f_fmt(close - nxXDn, "0.0"), color.orange)
    f_vhead(18, "CESTA V ČASE", "typicky od open", "úrovne od aktuálnej ceny · p90")
    nxt.prow(19, 30,  volScale, close)
    nxt.prow(20, 60,  volScale, close)
    nxt.prow(21, 120, volScale, close)
    nxt.prow(22, 240, volScale, close)
    nxt.prow(23, nxt.mins, volScale, close)
    f_vrow(24, "Typický čas high / low", hk >= 0 ? nxt.slotClock(hk) : "–", lk >= 0 ? "low " + nxt.slotClock(lk) + " (" + nxt.tz + ", " + str.tostring(hc) + "+" + str.tostring(lc) + " z " + str.tostring(hn) + ")" : "–", txtCol)
    f_vhead(25, "MAKRO VÄZBA (" + str.tostring(resLen) + " b)", mlOn ? "zlato skut. / implikované" : "off", mlOn ? "βDXY " + f_fmt(bD, "0.00") + " · β10Y " + f_fmt(bY * 100.0, "0.00") + " (×100, %/bp)" : "")
    f_vrow(26, "Pohyb zlata", mlOn ? f_sgn(cumAct, "0.00") + " % / " + f_sgn(cumImp, "0.00") + " %" : "–", mlOn ? "DXY " + f_sgn(dxyChg, "0.00") + " % · 10Y " + f_sgn(yldChg, "0") + " bp za " + str.tostring(resLen) + " b" : "–", txtCol)
    f_vrow(27, "Reziduál", mlOn ? f_sgn(cumRes, "0.00") + " % (z " + f_sgn(zRes, "0.0") + ")" : "–", mlOn ? f_mlText(zRes) : "–", mlOn and not na(zRes) ? (math.abs(zRes) > 1.5 ? color.orange : txtCol) : txtDim)
    f_vrow(28, "Pozn.", "štatistika, nie predpoveď", "pri FOMC / NFP / CPI rátaj s p90 až max · kužeľ sa škáluje vol scale, p90 nie", txtDim)

//-----------------------------------------------------------------------------}
//End of file: the code was pasted completely, clear the "KÓD JE NEÚPLNÝ" warning
//-----------------------------------------------------------------------------{
if barstate.islast
    table.cell(tWarn, 0, 0, "", bgcolor = color.new(color.black, 100))
// KONIEC SÚBORU – Gold G/F PRO v6
