showWeek = input.bool(true, "Týždenný prehľad", group = G_B)
showTop  = input.bool(true, "TOP najhlbšie ponory, počet", group = G_B, inline = "tt")
topN     = input.int(7, "", minval = 1, maxval = 15, group = G_B, inline = "tt")
posDet   = input.string("Vľavo dole", "Pozícia týždennej / TOP tabuľky", options = ["Vpravo hore", "Vpravo stred", "Vpravo dole", "Vľavo hore", "Vľavo stred", "Vľavo dole", "Stred hore", "Stred dole"], group = G_B)
showList = input.bool(false, "Zoznam všetkých obchodov", group = G_B, inline = "tl")
posList  = input.string("Vľavo hore", "", options = ["Vpravo hore", "Vpravo stred", "Vpravo dole", "Vľavo hore", "Vľavo stred", "Vľavo dole", "Stred hore", "Stred dole"], group = G_B, inline = "tl")
tblSize  = input.string("small", "Veľkosť tabuliek", options = ["tiny", "small", "normal"], group = G_B)

// ───────────────────────────── DÁTA ─────────────────────────────
