//@version=6
// =====================================================================
// SARUJA 21596244 – TRADE MAP  (vstupy • exity • ponory • trvanie • koše)
// Reálne uzavreté obchody účtu SARUJA (MT4 Pro USD, č. 21596244), XAUUSD,
// 01.09.2026 – 08.10.2026, 31 obchodov (všetky SELL), vklad 10 000 USD.
//
// INŠTALÁCIA (TradingView):
//   1. Otvor graf XAUUSD (ideálne M1 – M15, ponory sa počítajú zo sviečok grafu).
//   2. Dole klikni "Pine Editor", zmaž obsah, vlož celý tento súbor (Ctrl+A, Ctrl+V).
//   3. "Uložiť" (napr. "SARUJA Trade Map") → "Pridať do grafu".
//
// ČO VIDÍŠ PRI KAŽDOM OBCHODE:
//   ▸ Biela čiara          = entry (cena otvorenia) počas celého trvania obchodu
//   ▸ Zelená / červená zóna = cesta entry → exit (výška = zisk alebo strata v $/oz, šírka = trvanie)
//   ▸ Farebná zóna nad entry (pri SELL) = MAX PONOR (MAE): koľko $/oz išiel obchod proti,
//     dopočítané z high/low sviečok grafu medzi otvorením a zatvorením
//   ▸ ▼ marker            = bod, kde bol ponor najhlbší;  ▲ marker = najlepší bod (MFE)
//   ▸ Bodkovaná diagonála + ◆ = dráha entry → exit a bod zatvorenia
//   ▸ Štítok               = číslo, lot, entry → exit, zisk USD, ponor ($/oz, USD na účte, % účtu),
//                            trieda ponoru, trvanie, využitie MFE, pomer zisk/ponor
//   ▸ KÔŠ                  = pozície zatvorené naraz (priemerovanie): spoločný net a spoločný ponor
//   (prejdi myšou na ktorýkoľvek štítok → kompletný detail vrátane ticketu a zostatku účtu)
//
// FARBY PONORU (prahy sa dajú meniť, $ = USD za uncu, t. j. pohyb ceny):
//   ČISTÝ ≤ 5 $ (zelená) │ MIERNY ≤ 15 $ (limetková) │ VÝRAZNÝ ≤ 30 $ (oranžová)
//   HLBOKÝ ≤ 100 $ (červená) │ EXTRÉM > 100 $ (fialová) │ MIMO DÁT = sivá (graf nemá sviečky z toho obdobia)
//
// ČAS: export má časy "ako na stránke" bez pásma. Indikátor štandardne vyskúša všetky UTC posuny
//   a vyberie ten, pri ktorom najviac cien entry/exit sedí do rozpätia sviečky (výsledok je v tabuľke).
//   Ak by kalibrácia zlyhala (napr. na H1+), prepni na "Ručne" a zadaj posun servera (typicky UTC+3).
//
// TABUĽKY: prehľad účtu + rozdelenie ponoru, týždenný prehľad + TOP ponory, voliteľný zoznam obchodov.
// Dáta: saruja-21596244-historia.xlsx → tools/build_saruja.py (polia nižšie).
// =====================================================================
indicator("SARUJA 21596244 – Trade Map (vstupy • ponory • trvanie)", shorttitle = "SARUJA Trade Map", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_polylines_count = 10)
plot(close, "XAUUSD close", color = color.new(color.gray, 100), display = display.none, editable = false)

// ───────────────────────────── VSTUPY ─────────────────────────────
G_T = "① Čas exportu a kalibrácia"
tzMode = input.string("Automaticky (podľa sviečok)", "Časové pásmo exportu", options = ["Automaticky (podľa sviečok)", "Ručne (UTC posun nižšie)"], group = G_T, tooltip = "Časy v exporte nemajú pásmo. Automaticky = indikátor vyskúša UTC-12 … UTC+14 a vyberie posun, pri ktorom najviac cien entry/exit padne do rozpätia sviečky. Výsledok a kvalitu zhody vidíš v tabuľke Prehľad.")
tzMan  = input.int(3, "Ručný UTC posun exportu (hodiny)", minval = -12, maxval = 14, group = G_T, tooltip = "Použije sa pri režime Ručne a ako rozhodca pri remíze v automatike. MT4 servery majú v lete zvyčajne UTC+3, Bratislava UTC+2.")
tzDisp = input.string("Europe/Bratislava", "Časy v štítkoch zobrazovať v pásme", group = G_T, tooltip = "Názov pásma (napr. Europe/Bratislava, UTC, America/New_York).")
calTol = input.float(0.8, "Tolerancia ceny pri kalibrácii ($)", minval = 0, step = 0.1, group = G_T, tooltip = "O koľko $/oz môže byť entry/exit mimo high–low sviečky a stále sa počíta ako zhoda (spread, zaokrúhlenie).")

G_F = "② Filter"
fromT   = input.time(timestamp("01 Aug 2026 00:00 +0000"), "Od", group = G_F, inline = "dt")
toT     = input.time(timestamp("31 Dec 2027 00:00 +0000"), "Do", group = G_F, inline = "dt")
resMode = input.string("Všetky", "Zobraziť obchody", options = ["Všetky", "Iba ziskové", "Iba stratové", "Iba koše"], group = G_F)
