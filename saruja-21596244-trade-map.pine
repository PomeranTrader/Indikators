showEq  = input.bool(false, "Kresliť krivku plávajúceho P/L celého účtu", group = G_E, tooltip = "Súčet plávajúceho P/L všetkých otvorených pozícií po sviečkach. Kreslí sa ako pás pod minimom ceny (alebo na zadanej úrovni) – oddiaľ graf, aby si ho videl. Čísla (najhorší plávajúci P/L, equity DD) sú v tabuľke vždy.")
