// ───────────────────────────── POMOCNÉ ─────────────────────────────
BG  = #131722
HD  = #1E222D
TX  = #D1D4DC
MUT = #787B86
BRD = #2A2E39

f_size(string s) =>
    switch s
        "tiny"   => size.tiny
        "normal" => size.normal
        "large"  => size.large
        => size.small

f_pos(string s) =>
    switch s
        "Vpravo hore" => position.top_right
        "Vpravo stred" => position.middle_right
        "Vpravo dole" => position.bottom_right
        "Vľavo hore" => position.top_left
        "Vľavo stred" => position.middle_left
        "Vľavo dole" => position.bottom_left
        "Stred hore" => position.top_center
        => position.bottom_center

// trieda ponoru: -1 = bez dát, 0 ČISTÝ … 4 EXTRÉM
f_cls(float m) =>
    na(m) ? -1 : m <= th1 ? 0 : m <= th2 ? 1 : m <= th3 ? 2 : m <= th4 ? 3 : 4

f_clsCol(int k) =>
    k == 0 ? c0 : k == 1 ? c1 : k == 2 ? c2 : k == 3 ? c3 : k == 4 ? c4 : cNoM

f_clsName(int k) =>
    k == 0 ? "ČISTÝ" : k == 1 ? "MIERNY" : k == 2 ? "VÝRAZNÝ" : k == 3 ? "HLBOKÝ" : k == 4 ? "EXTRÉM" : "—"

f_rng(int k) =>
    k == 0 ? "≤ " + str.tostring(th1, "0") + " $" : k == 1 ? str.tostring(th1, "0") + " – " + str.tostring(th2, "0") + " $" : k == 2 ? str.tostring(th2, "0") + " – " + str.tostring(th3, "0") + " $" : k == 3 ? str.tostring(th3, "0") + " – " + str.tostring(th4, "0") + " $" : "> " + str.tostring(th4, "0") + " $"

// čitateľný text na farebnom pozadí
f_txtOn(color c) =>
    (0.299 * color.r(c) + 0.587 * color.g(c) + 0.114 * color.b(c)) > 140 ? color.black : color.white

f_px(float p) =>
    na(p) ? "—" : str.tostring(p, "0.00")

f_sgn(float x) =>
    na(x) ? "—" : (x >= 0 ? "+" : "") + str.tostring(x, "0.00") + " $"

f_pip(float x) =>
    showPip and not na(x) ? " (" + str.tostring(math.round(x * 10)) + " pip)" : ""

f_lotU(float x) =>
    na(x) ? "—" : str.tostring(x * 100 * lot, "0") + " USD @ " + str.tostring(lot, "0.00") + " lot"

f_rr(float p, float m) =>
    na(p) or na(m) ? "—" : m < 0.01 ? "∞" : str.tostring(p / m, "0.00")

f_dt(int t) =>
    str.format_time(t, "dd.MM. HH:mm", tz)

// hodiny → "36 min" / "4h 05m" / "1d 15h 49m"
f_dur(float h) =>
    string r = "—"
    if not na(h)
        int m  = math.round(h * 60)
        int dd = math.floor(m / 1440)
        int hh = math.floor((m - dd * 1440) / 60)
        int mm = m - dd * 1440 - hh * 60
        r := m < 1 ? "< 1 min" : dd > 0 ? str.tostring(dd) + "d " + str.tostring(hh) + "h " + str.tostring(mm, "00") + "m" : hh > 0 ? str.tostring(hh) + "h " + str.tostring(mm, "00") + "m" : str.tostring(mm) + " min"
    r

// ───────────────────── ŽIVÉ SLEDOVANIE OTVORENÝCH ─────────────────────
// Pre otvorené signály sa z grafu dopočítava ponor od vyplnenia entry a detekuje TP hit.
var array<float> LV = array.new<float>(array.size(T), na)   // živý max ponor (USD)
var array<bool>  LF = array.new<bool>(array.size(T), false)  // entry vyplnené
var array<int>   LH = array.new<int>(array.size(T), na)      // čas TP hit z grafu
var array<int>   OI = array.new<int>()
if barstate.isfirst
    for i = 0 to array.size(T) - 1
        if array.get(ST, i) == 2
            OI.push(i)

float pc = close[1]
for i in OI
    int   t0 = array.get(T, i)
    float en = array.get(EN, i)
    float tp = array.get(TP, i)
    if time >= t0 and not na(en) and na(array.get(LH, i))
        int d = tp >= en ? 1 : -1
        if not array.get(LF, i)
            bool crossed = not na(pc) and (pc - en) * (open - en) < 0
            if (low <= en and high >= en) or crossed
                array.set(LF, i, true)
        if array.get(LF, i)
            float adv = math.max(d == 1 ? en - low : high - en, 0.0)
            float cur = array.get(LV, i)
            array.set(LV, i, na(cur) ? adv : math.max(cur, adv))
            if (d == 1 and high >= tp) or (d == -1 and low <= tp)
                array.set(LH, i, time)

// efektívny stav: 1 TP hit, 2 otvorený, 3 TP hit iba podľa postu, 0 nevyhodnotené, 4 TP hit zistený z grafu
f_st(int i) =>
    int s = array.get(ST, i)
    s == 2 and not na(array.get(LH, i)) ? 4 : s

f_ma(int i) =>
    float m = array.get(MA, i)
    if array.get(ST, i) == 2
        float lv = array.get(LV, i)
        m := na(m) ? lv : na(lv) ? m : math.max(m, lv)
    m

f_hr(int i) =>
    float h = array.get(HR, i)
    if array.get(ST, i) == 2 and not na(array.get(LH, i))
        h := (array.get(LH, i) - array.get(T, i)) / 3600000.0
    h

f_noM(int i) =>
    int s = f_st(i)
    s == 0 or s == 3 or na(array.get(EN, i))

f_visible(int i) =>
    int  t0  = array.get(T, i)
    int  s   = f_st(i)
    bool noM = f_noM(i)
    bool ok  = t0 >= fromT and t0 <= toT
    ok := ok and (noM ? showNoM and minMae <= 0 : s == 2 ? showOpn : showHit)
    if ok and not noM and minMae > 0
        float m = f_ma(i)
        ok := not na(m) and m >= minMae
    ok

// ───────────────────────────── TEXTY ─────────────────────────────
f_lbl(int i) =>
    int    t0   = array.get(T, i)
    float  en   = array.get(EN, i)
    float  tp   = array.get(TP, i)
    int    s    = f_st(i)
    float  ma   = f_ma(i)
    float  hr   = f_hr(i)
    bool   ed   = array.get(ED, i)
    bool   noM  = f_noM(i)
    int    d    = na(en) or tp >= en ? 1 : -1
    int    k    = f_cls(ma)
    string num  = "#" + str.tostring(i + 1)
    string side = d == 1 ? "▲ BUY" : "▼ SELL"
    string stT  = switch s
        1 => "TP ✓"
        4 => "TP ✓ (graf)"
        2 => "OTVORENÝ"
        3 => "TP ✓ (iba post)"
        => "nevyhodnotené"
    float  prof = na(en) ? na : math.abs(tp - en)
    float  flt  = s == 2 ? d * (close - en) : na
    float  runH = (nz(time_close, timenow) - t0) / 3600000.0
    string durT = s == 2 ? "beží " + f_dur(runH) : f_dur(hr)
    // plný text
    string full = num + "  " + side + " · " + stT + " · " + f_dt(t0) + (ed ? " ✎" : "")
    if noM
        full += "\nTP " + f_px(tp) + (na(en) ? "" : "  ·  E " + f_px(en)) + "  · bez metrík"
    else
        full += "\nE " + f_px(en) + " → TP " + f_px(tp) + "   +" + f_px(prof) + " $"
        full += "\n▼ PONOR " + f_px(ma) + " $" + f_pip(ma) + " · " + f_clsName(k)
        full += "\n⏱ " + durT + (s == 2 ? " · P/L " + f_sgn(flt) : " · zisk/ponor " + f_rr(prof, ma))
    // kompaktný text
    string cmp = noM ? num + " " + (s == 3 ? "TP ✓ post" : "nevyhodn.") : num + (s == 2 ? " OTV" : "") + "  ▼" + str.tostring(ma, "0.0") + "$  ⏱" + durT
    // tooltip
    string tip = "Signál " + num + " (" + (d == 1 ? "BUY" : "SELL") + ") · " + stT
    tip += "\nPost: " + str.format_time(t0, "dd.MM.yyyy HH:mm", tz) + (ed ? "  (čas upravený)" : "")
    tip += na(en) ? "\nTP " + f_px(tp) + "  (entry neznáme)" : "\nEntry " + f_px(en) + "   TP " + f_px(tp)
    if not noM
        tip += "\n────────────"
        tip += "\nZisk do TP: +" + f_px(prof) + " $" + f_pip(prof) + " = " + f_lotU(prof)
        tip += "\nMax ponor: " + f_px(ma) + " $" + f_pip(ma) + " = " + f_lotU(ma) + "  → " + f_clsName(k)
        if s == 2
            tip += "\nBeží: " + f_dur(runH) + "\nPlávajúci P/L: " + f_sgn(flt) + " = " + f_lotU(flt)
        else
            tip += "\nTrvanie do TP: " + f_dur(hr) + "  (TP hit " + f_dt(t0 + math.round(hr * 3600000)) + ")"
        tip += "\nZisk / ponor: " + f_rr(prof, ma)
    [full, cmp, num, tip]

// ───────────────────────────── KRESLENIE ─────────────────────────────
f_draw(int i, array<box> bx, array<line> ln, array<label> lb) =>
    int   t0    = array.get(T, i)
    float en    = array.get(EN, i)
    float tp    = array.get(TP, i)
    int   s     = f_st(i)
    float ma    = f_ma(i)
    float hr    = f_hr(i)
    bool  noM   = f_noM(i)
    bool  isOpn = s == 2
    int   d     = na(en) or tp >= en ? 1 : -1
    int   k     = f_cls(ma)
    int   minMs = math.max(minW * 60000, timeframe.in_seconds() * 1000)
    int   tHit  = noM or isOpn ? na : t0 + math.round(hr * 3600000)
    int   tEnd  = noM ? t0 + noMLen * 3600000 : isOpn ? math.max(nz(time_close, timenow), t0 + minMs) : math.max(tHit, t0 + minMs)
    int   tMid  = t0 + math.round((tEnd - t0) / 2)
    color cS    = noM ? cNoM : isOpn ? cOpen : f_clsCol(k)
    color cD    = f_clsCol(k)
    bool  dim   = focus and not noM and not isOpn and k < 2
    int   tr    = dim ? math.min(zTr + 15, 96) : zTr
    float yTop  = na(en) ? tp : d == 1 ? math.max(en, tp) : math.min(en, tp)
    [full, cmp, num, tip] = f_lbl(i)
    if noM
        if showEntry and not na(en)
            ln.push(line.new(t0, en, tEnd, en, xloc = xloc.bar_time, color = color.new(cNoM, 20), width = 2))
        ln.push(line.new(t0, tp, tEnd, tp, xloc = xloc.bar_time, color = cNoM, style = line.style_dashed, width = 1))
    else
        float ddP = d == 1 ? en - ma : en + ma
        if showZone
            bx.push(box.new(t0, math.max(en, tp), tEnd, math.min(en, tp), border_color = color.new(isOpn ? cOpen : cZone, dim ? 75 : 25), border_width = 1, xloc = xloc.bar_time, bgcolor = color.new(isOpn ? cOpen : cZone, tr)))
        if showDD and not na(ma) and ma > 0
            bx.push(box.new(t0, math.max(en, ddP), tEnd, math.min(en, ddP), border_color = color.new(cD, dim ? 75 : 15), border_width = 1, xloc = xloc.bar_time, bgcolor = color.new(cD, tr)))
        if showEntry
            ln.push(line.new(t0, en, tEnd, en, xloc = xloc.bar_time, color = color.new(cEntry, dim ? 65 : 0), width = 2))
        if showPath and not isOpn
            ln.push(line.new(t0, en, tHit, tp, xloc = xloc.bar_time, color = color.new(cZone, dim ? 65 : 0), style = line.style_dotted, width = 2))
        if showHitMk and not isOpn
            lb.push(label.new(tHit, tp, "", xloc = xloc.bar_time, style = label.style_diamond, color = color.new(cZone, dim ? 65 : 0), size = size.tiny, tooltip = num + " TP zasiahnutý " + f_dt(tHit) + " po " + f_dur(hr)))
        if showDepth and not na(ma) and ma >= depthMin
            lb.push(label.new(tMid, ddP, "▼ " + str.tostring(ma, "0.0") + " $", xloc = xloc.bar_time, style = d == 1 ? label.style_label_up : label.style_label_down, color = color.new(cD, dim ? 65 : 10), textcolor = f_txtOn(cD), size = size.tiny, tooltip = tip))
    if lblMode != "Skryť"
        string txt = lblMode == "Plné" ? full : lblMode == "Kompaktné" ? cmp : num
        lb.push(label.new(tMid, yTop, txt, xloc = xloc.bar_time, style = d == 1 ? label.style_label_down : label.style_label_up, color = color.new(cS, dim ? 70 : 8), textcolor = dim ? color.new(f_txtOn(cS), 40) : f_txtOn(cS), size = f_size(lblSize), textalign = text.align_left, tooltip = tip))
    true

// ───────────────────────────── TABUĽKY ─────────────────────────────
f_c(table tb, int c, int r, string txt, color bg, color fg, string tip, string ha) =>
    table.cell(tb, c, r, txt, text_color = fg, bgcolor = bg, text_size = f_size(tblSize), text_halign = ha, tooltip = tip)
    true

f_mon(int key) =>
    array<string> MN = array.from("Jan", "Feb", "Mar", "Apr", "Máj", "Jún", "Júl", "Aug", "Sep", "Okt", "Nov", "Dec")
    MN.get(key % 100 - 1) + " " + str.tostring(math.floor(key / 100) % 100, "00")

var table tM = table.new(f_pos(posMain), 6, 15, bgcolor = BG, frame_color = BRD, frame_width = 1, border_color = BRD, border_width = 1)
var table tD = table.new(f_pos(posDet), 7, 45, bgcolor = BG, frame_color = BRD, frame_width = 1, border_color = BRD, border_width = 1)

// ───────────────────────────── HLAVNÝ BEH ─────────────────────────────
var array<box>   sBx = array.new<box>()
var array<line>  sLn = array.new<line>()
var array<label> sLb = array.new<label>()
var array<box>   oBx = array.new<box>()
var array<line>  oLn = array.new<line>()
var array<label> oLb = array.new<label>()
var bool drawn = false

if barstate.islast
    int N = array.size(T)
    bool first = not drawn
    // 1) uzavreté signály – nakreslia sa raz
    if first
        drawn := true
        for i = 0 to N - 1
            if array.get(ST, i) != 2 and f_visible(i)
                f_draw(i, sBx, sLn, sLb)
    // 2) otvorené signály – prekresľujú sa každý tick (živý ponor, P/L, trvanie)
    while oBx.size() > 0
        box.delete(oBx.pop())
    while oLn.size() > 0
        line.delete(oLn.pop())
    while oLb.size() > 0
        label.delete(oLb.pop())
    for i in OI
        if f_visible(i)
            f_draw(i, oBx, oLn, oLb)

    // 3) štatistiky (filter dátumu)
    int nAll  = 0
    int nHit  = 0
    int nOpn  = 0
    int nNoM  = 0
    int nEd   = 0
    int nDeep = 0
    int nOver = 0
    int iMax  = -1
    float vMax = -1.0
    int tFirst = na
    int tLast  = na
    array<float> aMA = array.new<float>()
    array<float> aHR = array.new<float>()
    array<float> aPR = array.new<float>()
    array<int>   cN  = array.new<int>(5, 0)
    array<float> cH  = array.new<float>(5, 0.0)
    array<int>   mK  = array.new<int>()
    array<int>   mN  = array.new<int>()
    array<int>   mH  = array.new<int>()
    array<int>   mDp = array.new<int>()
    array<float> mSM = array.new<float>()
    array<float> mMx = array.new<float>()
    array<float> mSH = array.new<float>()
    array<int>   tI  = array.new<int>()
    array<float> tV  = array.new<float>()
    for i = 0 to N - 1
        int t0 = array.get(T, i)
        if t0 < fromT or t0 > toT
            continue
        nAll += 1
        tFirst := na(tFirst) ? t0 : tFirst
        tLast  := t0
        if array.get(ED, i)
            nEd += 1
        int key = year(t0, tz) * 100 + month(t0, tz)
        int mi  = mK.indexof(key)
        if mi < 0
            mK.push(key)
            mN.push(0)
            mH.push(0)
            mDp.push(0)
            mSM.push(0.0)
            mMx.push(0.0)
            mSH.push(0.0)
            mi := mK.size() - 1
        mN.set(mi, mN.get(mi) + 1)
        int s = f_st(i)
        if f_noM(i)
            nNoM += 1
            continue
        float ma = f_ma(i)
        float hr = f_hr(i)
        float pr = math.abs(array.get(TP, i) - array.get(EN, i))
        if not na(ma)
            tI.push(i)
            tV.push(ma)
            if ma > vMax
                vMax := ma
                iMax := i
            if ma > th2
                nDeep += 1
            if ma > pr
                nOver += 1
        if s == 2
            nOpn += 1
        else
            nHit += 1
            if not na(ma)
                aMA.push(ma)
                int k = f_cls(ma)
                cN.set(k, cN.get(k) + 1)
                cH.set(k, cH.get(k) + nz(hr))
                mSM.set(mi, mSM.get(mi) + ma)
                mMx.set(mi, math.max(mMx.get(mi), ma))
                if ma > th2
                    mDp.set(mi, mDp.get(mi) + 1)
            if not na(hr)
                aHR.push(hr)
                mSH.set(mi, mSH.get(mi) + hr)
            aPR.push(pr)
            mH.set(mi, mH.get(mi) + 1)

    int   nEval = nHit + nOpn
    float avgMA = aMA.size() > 0 ? aMA.avg() : na
    float medMA = aMA.size() > 0 ? aMA.median() : na
    float avgHR = aHR.size() > 0 ? aHR.avg() : na
    float medHR = aHR.size() > 0 ? aHR.median() : na
    float maxHR = aHR.size() > 0 ? aHR.max() : na
    float avgPR = aPR.size() > 0 ? aPR.avg() : na
    float ratio = na(avgPR) or na(avgMA) or avgMA <= 0 ? na : avgPR / avgMA
    string ptxt = nEval > 0 ? " (" + str.tostring(100.0 * nHit / nEval, "0.0") + " %)" : ""

    // ── tabuľka: prehľad + rozdelenie ponoru
    if showMain
        if first
            tM.merge_cells(0, 0, 5, 0)
            tM.merge_cells(0, 6, 5, 6)
        string rng = na(tFirst) ? "žiadne signály vo filtri" : str.format_time(tFirst, "dd.MM.yy", tz) + " – " + str.format_time(tLast, "dd.MM.yy", tz)
        f_c(tM, 0, 0, "GFX MS 2026 · MAPA OBCHODOV  │  " + rng, HD, TX, "Štatistiky rešpektujú filter dátumu. Upravené časy postov: " + str.tostring(nEd), text.align_center)
        f_c(tM, 0, 1, "Signály", HD, MUT, "", text.align_left)
        f_c(tM, 1, 1, str.tostring(nAll), BG, TX, "", text.align_center)
        f_c(tM, 2, 1, "TP ✓", HD, MUT, "TP zasiahnutý / (TP zasiahnutý + otvorené)", text.align_left)
        f_c(tM, 3, 1, str.tostring(nHit) + ptxt, BG, cZone, "", text.align_center)
        f_c(tM, 4, 1, "Otvorené", HD, MUT, "", text.align_left)
        f_c(tM, 5, 1, str.tostring(nOpn), nOpn > 0 ? color.new(cOpen, 35) : BG, TX, "", text.align_center)
        f_c(tM, 0, 2, "Bez metrík", HD, MUT, "TP hit iba podľa postu / nevyhodnotené (neznáme entry)", text.align_left)
        f_c(tM, 1, 2, str.tostring(nNoM), BG, TX, "", text.align_center)
        f_c(tM, 2, 2, "Ponor > " + str.tostring(th2, "0") + " $", HD, MUT, "Počet obchodov (vrátane otvorených) s ponorom nad prahom MIERNY", text.align_left)
        f_c(tM, 3, 2, str.tostring(nDeep) + (nEval > 0 ? " (" + str.tostring(100.0 * nDeep / nEval, "0.0") + " %)" : ""), BG, c3, "", text.align_center)
        f_c(tM, 4, 2, "Ponor > zisk", HD, MUT, "Obchody, kde max ponor bol väčší ako vzdialenosť entry → TP", text.align_left)
        f_c(tM, 5, 2, str.tostring(nOver) + (nEval > 0 ? " (" + str.tostring(100.0 * nOver / nEval, "0.0") + " %)" : ""), BG, c2, "", text.align_center)
        f_c(tM, 0, 3, "Ø ponor", HD, MUT, "Iba TP ✓ obchody", text.align_left)
        f_c(tM, 1, 3, f_px(avgMA) + " $", color.new(f_clsCol(f_cls(avgMA)), 60), TX, f_lotU(avgMA), text.align_center)
        f_c(tM, 2, 3, "Medián", HD, MUT, "", text.align_left)
        f_c(tM, 3, 3, f_px(medMA) + " $", color.new(f_clsCol(f_cls(medMA)), 60), TX, f_lotU(medMA), text.align_center)
        f_c(tM, 4, 3, "Max ponor", HD, MUT, "Vrátane otvorených", text.align_left)
        f_c(tM, 5, 3, iMax < 0 ? "—" : f_px(vMax) + " $ #" + str.tostring(iMax + 1), iMax < 0 ? BG : color.new(f_clsCol(f_cls(vMax)), 40), TX, iMax < 0 ? "" : f_lotU(vMax) + " · " + str.format_time(array.get(T, iMax), "dd.MM.yyyy HH:mm", tz), text.align_center)
        f_c(tM, 0, 4, "Ø trvanie", HD, MUT, "Čas od postu po TP hit", text.align_left)
        f_c(tM, 1, 4, f_dur(avgHR), BG, TX, "", text.align_center)
        f_c(tM, 2, 4, "Medián", HD, MUT, "", text.align_left)
        f_c(tM, 3, 4, f_dur(medHR), BG, TX, "", text.align_center)
        f_c(tM, 4, 4, "Max trvanie", HD, MUT, "", text.align_left)
        f_c(tM, 5, 4, f_dur(maxHR), BG, TX, "", text.align_center)
        f_c(tM, 0, 5, "Ø zisk TP", HD, MUT, "", text.align_left)
        f_c(tM, 1, 5, f_px(avgPR) + " $", BG, cZone, f_lotU(avgPR), text.align_center)
        f_c(tM, 2, 5, "Ø zisk / Ø ponor", HD, MUT, "< 1 = obchody v priemere idú viac proti, než koľko zarobia na TP", text.align_left)
        f_c(tM, 3, 5, na(ratio) ? "—" : str.tostring(ratio, "0.00"), na(ratio) ? BG : ratio >= 1 ? color.new(c0, 55) : color.new(c3, 55), TX, "", text.align_center)
        f_c(tM, 4, 5, "Ø ponor @lot", HD, MUT, "Prepočet na zvolený lot (1 lot = 100 oz)", text.align_left)
        f_c(tM, 5, 5, na(avgMA) ? "—" : str.tostring(avgMA * 100 * lot, "0") + " USD", BG, TX, "@ " + str.tostring(lot, "0.00") + " lot", text.align_center)
        f_c(tM, 0, 6, "ROZDELENIE PONORU  (TP ✓ obchody)", HD, TX, "", text.align_center)
        f_c(tM, 0, 7, "Trieda", HD, MUT, "", text.align_center)
        f_c(tM, 1, 7, "Rozsah", HD, MUT, "", text.align_center)
        f_c(tM, 2, 7, "Počet", HD, MUT, "", text.align_center)
        f_c(tM, 3, 7, "%", HD, MUT, "", text.align_center)
        f_c(tM, 4, 7, "Graf", HD, MUT, "", text.align_left)
        f_c(tM, 5, 7, "Ø trvanie", HD, MUT, "", text.align_center)
        for k = 0 to 4
            int   n   = cN.get(k)
            float pct = aMA.size() > 0 ? 100.0 * n / aMA.size() : 0.0
            int   nb  = math.round(pct / 4)
            color cc  = f_clsCol(k)
            f_c(tM, 0, 8 + k, f_clsName(k), cc, f_txtOn(cc), "", text.align_center)
            f_c(tM, 1, 8 + k, f_rng(k), BG, TX, "", text.align_center)
            f_c(tM, 2, 8 + k, str.tostring(n), BG, TX, "", text.align_center)
            f_c(tM, 3, 8 + k, str.tostring(pct, "0.0") + " %", BG, TX, "", text.align_center)
            f_c(tM, 4, 8 + k, nb > 0 ? str.repeat("█", nb) : "·", BG, cc, "", text.align_left)
            f_c(tM, 5, 8 + k, n > 0 ? f_dur(cH.get(k) / n) : "—", BG, TX, "", text.align_center)
        f_c(tM, 0, 13, "OTVORENÝ", cOpen, f_txtOn(cOpen), "", text.align_center)
        f_c(tM, 1, 13, "beží", BG, MUT, "", text.align_center)
        f_c(tM, 2, 13, str.tostring(nOpn), BG, TX, "", text.align_center)
        f_c(tM, 3, 13, "", BG, TX, "", text.align_center)
        f_c(tM, 4, 13, "živý ponor + P/L z grafu", BG, MUT, "", text.align_left)
        f_c(tM, 5, 13, "", BG, TX, "", text.align_center)
        f_c(tM, 0, 14, "BEZ METRÍK", cNoM, f_txtOn(cNoM), "", text.align_center)
        f_c(tM, 1, 14, "iba TP", BG, MUT, "", text.align_center)
        f_c(tM, 2, 14, str.tostring(nNoM), BG, TX, "", text.align_center)
        f_c(tM, 3, 14, "", BG, TX, "", text.align_center)
        f_c(tM, 4, 14, "prerušovaná čiara TP", BG, MUT, "", text.align_left)
        f_c(tM, 5, 14, "", BG, TX, "", text.align_center)

    // ── tabuľka: mesačný prehľad + TOP ponory
    int r = 0
    if showMon and mK.size() > 0
        if first
            tD.merge_cells(0, r, 6, r)
        f_c(tD, 0, r, "MESAČNÝ PREHĽAD", HD, TX, "", text.align_center)
        r += 1
        f_c(tD, 0, r, "Mesiac", HD, MUT, "", text.align_center)
        f_c(tD, 1, r, "Sig.", HD, MUT, "Všetky signály v mesiaci", text.align_center)
        f_c(tD, 2, r, "TP ✓", HD, MUT, "", text.align_center)
        f_c(tD, 3, r, "Ø ponor", HD, MUT, "", text.align_center)
        f_c(tD, 4, r, "Max ponor", HD, MUT, "", text.align_center)
        f_c(tD, 5, r, "Ø trvanie", HD, MUT, "", text.align_center)
        f_c(tD, 6, r, "> " + str.tostring(th2, "0") + " $", HD, MUT, "Počet TP ✓ obchodov s ponorom nad prahom MIERNY", text.align_center)
        r += 1
        for mi = 0 to math.min(mK.size(), 24) - 1
            int   h   = mH.get(mi)
            float aM  = h > 0 ? mSM.get(mi) / h : na
            float mX  = h > 0 ? mMx.get(mi) : na
            float aH  = h > 0 ? mSH.get(mi) / h : na
            int   dp  = mDp.get(mi)
            f_c(tD, 0, r, f_mon(mK.get(mi)), HD, TX, "", text.align_left)
            f_c(tD, 1, r, str.tostring(mN.get(mi)), BG, TX, "", text.align_center)
            f_c(tD, 2, r, str.tostring(h), BG, cZone, "", text.align_center)
            f_c(tD, 3, r, na(aM) ? "—" : f_px(aM) + " $", na(aM) ? BG : color.new(f_clsCol(f_cls(aM)), 60), TX, "", text.align_center)
            f_c(tD, 4, r, na(mX) ? "—" : f_px(mX) + " $", na(mX) ? BG : color.new(f_clsCol(f_cls(mX)), 45), TX, "", text.align_center)
            f_c(tD, 5, r, f_dur(aH), BG, TX, "", text.align_center)
            f_c(tD, 6, r, str.tostring(dp), dp > 0 ? color.new(c3, 70) : BG, TX, "", text.align_center)
            r += 1
    if showTop and tV.size() > 0
        if first
            tD.merge_cells(0, r, 6, r)
        int nTop = math.min(topN, tV.size())
        f_c(tD, 0, r, "TOP " + str.tostring(nTop) + " NAJHLBŠÍCH PONOROV", HD, TX, "", text.align_center)
        r += 1
        f_c(tD, 0, r, "#", HD, MUT, "", text.align_center)
        f_c(tD, 1, r, "Dátum", HD, MUT, "", text.align_center)
        f_c(tD, 2, r, "Stav", HD, MUT, "", text.align_center)
        f_c(tD, 3, r, "Ponor", HD, MUT, "", text.align_center)
        f_c(tD, 4, r, "@ " + str.tostring(lot, "0.00") + " lot", HD, MUT, "", text.align_center)
        f_c(tD, 5, r, "Trvanie", HD, MUT, "", text.align_center)
        f_c(tD, 6, r, "Zisk TP", HD, MUT, "", text.align_center)
        r += 1
        array<int> ord = tV.sort_indices(order.descending)
        for j = 0 to nTop - 1
            int   i  = tI.get(ord.get(j))
            int   s  = f_st(i)
            float ma = tV.get(ord.get(j))
            float hr = f_hr(i)
            color cc = f_clsCol(f_cls(ma))
            [full, cmp, num, tip] = f_lbl(i)
            f_c(tD, 0, r, num, HD, TX, tip, text.align_center)
            f_c(tD, 1, r, str.format_time(array.get(T, i), "dd.MM.yy HH:mm", tz), BG, TX, tip, text.align_center)
            f_c(tD, 2, r, s == 2 ? "OTVORENÝ" : s == 4 ? "TP ✓ graf" : "TP ✓", s == 2 ? cOpen : BG, s == 2 ? f_txtOn(cOpen) : cZone, "", text.align_center)
            f_c(tD, 3, r, f_px(ma) + " $", cc, f_txtOn(cc), tip, text.align_center)
            f_c(tD, 4, r, str.tostring(ma * 100 * lot, "0") + " USD", BG, TX, "", text.align_center)
            f_c(tD, 5, r, s == 2 ? "beží " + f_dur((nz(time_close, timenow) - array.get(T, i)) / 3600000.0) : f_dur(hr), BG, TX, "", text.align_center)
            f_c(tD, 6, r, "+" + f_px(math.abs(array.get(TP, i) - array.get(EN, i))) + " $", BG, cZone, "", text.align_center)
            r += 1
