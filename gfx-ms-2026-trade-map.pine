//@version=6
// =====================================================================
// GFX MS 2026 – TRADE MAP v2  (ponor • trvanie • TP • štatistiky)
// Manuálne signály GFX Premier Club 29.12.2025 – 08.10.2026, XAUUSD
//
// INŠTALÁCIA (TradingView):
//   1. Otvor graf XAUUSD (ideálne M5 – H1), dole klikni "Pine Editor".
//   2. Zmaž obsah editora, vlož celý tento súbor (Ctrl+A, Ctrl+V).
//   3. "Uložiť" (napr. "GFX MS Trade Map") → "Pridať do grafu".
//
// ČO VIDÍŠ PRI KAŽDOM OBCHODE:
//   ▸ Tyrkysová zóna   = cesta entry → TP (výška = zisk, šírka = trvanie do TP)
//   ▸ Farebná zóna     = MAX PONOR pod entry (výška = koľko USD išiel obchod proti)
//   ▸ Biela čiara      = entry,  bodkovaná diagonála = dráha entry → bod TP hit ◆
//   ▸ Štítok           = číslo, ponor, trvanie, zisk, pomer zisk/ponor
//                        (prejdi myšou na štítok → kompletný detail + prepočet na loty)
//   ▸ Štítok ▼ pod zónou = hĺbka ponoru (len pri ponore ≥ zvolený prah)
//
// FARBY PONORU (prahy sa dajú meniť):
//   ČISTÝ ≤ 5 $ (zelená) │ MIERNY ≤ 15 $ (limetková) │ VÝRAZNÝ ≤ 30 $ (oranžová)
//   HLBOKÝ ≤ 100 $ (červená) │ EXTRÉM > 100 $ (fialová)
//   OTVORENÝ = modrá (živé sledovanie ponoru a P/L z grafu)
//   BEZ METRÍK = sivomodrá prerušovaná (TP hit iba podľa postu / nevyhodnotené)
//
// TABUĽKY: prehľad + rozdelenie ponoru, mesačný prehľad, TOP najhlbšie ponory.
// Dáta: gfx.db setup_metrics (MAE strict fill), otvorené signály podľa stavu 2026-10-07.
// Časy postov sú UNIX ms (Europe/Bratislava), "✎" = čas postu bol upravený (edited).
// =====================================================================
indicator("GFX MS 2026 – Trade Map v2 (ponor • trvanie • TP)", shorttitle = "GFX MS Trade Map v2", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)
plot(close, "XAUUSD close", color = color.new(color.gray, 100), display = display.none, editable = false)

// ───────────────────────────── VSTUPY ─────────────────────────────
G_F = "① Filter"
fromT   = input.time(timestamp("01 Dec 2025 00:00 +0000"), "Od", group = G_F, inline = "dt")
toT     = input.time(timestamp("31 Dec 2027 00:00 +0000"), "Do", group = G_F, inline = "dt")
showHit = input.bool(true, "TP hit (vyhodnotené)", group = G_F)
showOpn = input.bool(true, "Otvorené", group = G_F)
showNoM = input.bool(true, "Bez metrík (TP iba podľa postu / nevyhodnotené)", group = G_F)
minMae  = input.float(0.0, "Zobraziť iba ponor ≥ (USD)", minval = 0, step = 1, group = G_F, tooltip = "0 = všetko. Napr. 15 ukáže iba obchody s ponorom 15 $ a viac (signály bez metrík sa skryjú).")
focus   = input.bool(false, "Zvýrazniť VÝRAZNÝ+ ponor (ostatné stlmiť)", group = G_F)

G_V = "② Vizuál obchodu"
showZone  = input.bool(true, "Zóna zisku entry → TP", group = G_V)
showDD    = input.bool(true, "Zóna ponoru entry → max ponor", group = G_V)
showEntry = input.bool(true, "Čiara entry", group = G_V)
showPath  = input.bool(true, "Dráha entry → TP hit (diagonála)", group = G_V)
showHitMk = input.bool(true, "Bod TP hit ◆", group = G_V)
showDepth = input.bool(true, "Štítok hĺbky ▼ pod zónou ponoru, od", group = G_V, inline = "dp")
depthMin  = input.float(15.0, "USD", minval = 0, group = G_V, inline = "dp")
minW      = input.int(20, "Min. šírka zóny (minúty)", minval = 1, group = G_V, tooltip = "Obchody, ktoré trafili TP za pár sekúnd, by inak mali neviditeľnú zónu.")
noMLen    = input.int(6, "Dĺžka čiar pri signáloch bez metrík (hodiny)", minval = 1, group = G_V)
zTr       = input.int(78, "Priehľadnosť zón (0 = plné, 100 = neviditeľné)", minval = 0, maxval = 100, group = G_V)

G_L = "③ Štítky"
lblMode = input.string("Plné", "Režim štítkov", options = ["Plné", "Kompaktné", "Iba číslo", "Skryť"], group = G_L, tooltip = "Plné = všetky údaje na grafe. Kompaktné = číslo, ponor, trvanie. Detail je vždy v tooltipe (prejdi myšou na štítok).")
lblSize = input.string("small", "Veľkosť štítkov", options = ["tiny", "small", "normal", "large"], group = G_L)
showPip = input.bool(true, "Zobraziť aj pipy (1 USD = 10 pip)", group = G_L)
lot     = input.float(0.10, "Lot pre prepočet na USD (1 lot = 100 oz)", minval = 0.01, step = 0.01, group = G_L)
tz      = input.string("Europe/Bratislava", "Časová zóna textov", group = G_L)

G_C = "④ Prahy a farby ponoru (USD)"
th1    = input.float(5.0,   "ČISTÝ ≤",   group = G_C, inline = "c0")
c0     = input.color(#00E676, "",        group = G_C, inline = "c0")
th2    = input.float(15.0,  "MIERNY ≤",  group = G_C, inline = "c1")
c1     = input.color(#C6FF00, "",        group = G_C, inline = "c1")
th3    = input.float(30.0,  "VÝRAZNÝ ≤", group = G_C, inline = "c2")
c2     = input.color(#FFAB00, "",        group = G_C, inline = "c2")
th4    = input.float(100.0, "HLBOKÝ ≤",  group = G_C, inline = "c3")
c3     = input.color(#FF3D00, "",        group = G_C, inline = "c3")
c4     = input.color(#D500F9, "EXTRÉM (nad HLBOKÝ)", group = G_C)
cZone  = input.color(#26A69A, "Zóna zisku / TP", group = G_C, inline = "z")
cEntry = input.color(#E0E0E0, "Entry", group = G_C, inline = "z")
cOpen  = input.color(#2979FF, "Otvorený", group = G_C, inline = "o")
cNoM   = input.color(#78909C, "Bez metrík", group = G_C, inline = "o")

G_T = "⑤ Tabuľky"
showMain = input.bool(true, "Prehľad + rozdelenie ponoru", group = G_T, inline = "tm")
posMain  = input.string("Vpravo hore", "", options = ["Vpravo hore", "Vpravo stred", "Vpravo dole", "Vľavo hore", "Vľavo stred", "Vľavo dole", "Stred hore", "Stred dole"], group = G_T, inline = "tm")
showMon  = input.bool(true, "Mesačný prehľad", group = G_T)
showTop  = input.bool(true, "TOP najhlbšie ponory, počet", group = G_T, inline = "tt")
topN     = input.int(7, "", minval = 1, maxval = 15, group = G_T, inline = "tt")
posDet   = input.string("Vľavo dole", "Pozícia mesačnej / TOP tabuľky", options = ["Vpravo hore", "Vpravo stred", "Vpravo dole", "Vľavo hore", "Vľavo stred", "Vľavo dole", "Stred hore", "Stred dole"], group = G_T)
tblSize  = input.string("small", "Veľkosť tabuliek", options = ["tiny", "small", "normal"], group = G_T)

