//@version=6
// ============================================
//  Infinity Pullback Return – Buy the Dip (štatistika návratu k open impulzu)
//  An Infinity Original
//  © 2026 Infinity · v1.0 · 2026-10-14
// ============================================
//
// ČO ROBÍ:
//   1) Na zvolenom impulznom timeframe (H4 / H1 / iný) hľadá ROBUSTNÉ sviečky (telo ≥ násobok ATR
//      alebo ≥ percentil tiel). Pre každú vyráta „gap" = vzdialenosť close → open sviečky.
//   2) Na grafe (ideálne M15 / H1) potom bar po bare meria, KEDY sa cena vráti na OPEN impulznej
//      sviečky (zavretie gapu = pullback / buy the dip), koľko ešte pred návratom „ubehla" nad close
//      a ako hlboko išla POD open po návrate (možný návrat / očakávaný ponor).
//   3) Pri každom impulze si uloží vzdialenosť ceny od všetkých šiestich línií MMA stacku
//      (Focus Touch MA, Daily Tester MA, First / Second / Third Trend Tester, Last Barricade)
//      a počet línií ležiacich vnútri gapu (bariéry). Štatistika potom ukazuje, ako vzdialenosť
//      a bariéry menia pravdepodobnosť a čas návratu.
//   4) Potvrdenie pullbacku = otočka na Focus Touch MA (close pod ňu / jej sklon sa otočí).
//   5) Greed & Fear index 0–100 z RSI, natiahnutia od Daily Tester / First Trend Tester, momentum,
//      dĺžky série bez dotyku Focus Touch MA a šírky býčích sviečok. Režim sa ukladá ku každému impulzu.
//   6) MS MODEL: generuje vlastné BUY (SELL) signály = dotyk open impulzu + otočka Focus Touch MA
//      + filtre (trend, G&F) a hneď ich spätne testuje (TP v USD, ponor MAE, čas do TP) proti
//      reálnej štatistike GFX MS 2026 (158 signálov). Pri signáli kreslí očakávaný ponor P50/P75/P90.
//   7) Všetky pravdepodobnosti a časy sú percentily zo skutočnej histórie na grafe – žiadne konštanty.
//
// INŠTALÁCIA: graf XAUUSD M15 alebo H1 → Pine Editor → vlož CELÝ súbor → Uložiť → Pridať do grafu.
//   Posledný riadok súboru je "// KONIEC SÚBORU – Infinity Pullback Return v1.0".
//   Impulzný timeframe musí byť ROVNAKÝ alebo VYŠŠÍ ako timeframe grafu.
//   Čím viac histórie má graf (TradingView plán), tým robustnejšia štatistika.
// ============================================
indicator("Infinity Pullback Return – Buy the Dip", shorttitle = "Infinity Pullback Return", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 500)

// Kontrola úplnosti vloženého kódu (zruší sa na konci súboru)
var table tWarn = table.new(position.middle_center, 1, 1)
if barstate.islast
    table.cell(tWarn, 0, 0, "⚠ KÓD JE NEÚPLNÝ\nDo Pine Editora sa vložila iba časť súboru.\nSkopíruj CELÝ kód (posledný riadok je\n\"// KONIEC SÚBORU – Infinity Pullback Return v1.0\").", text_color = color.white, bgcolor = #C62828, text_size = size.large)

// ───────────────────────────── VSTUPY ─────────────────────────────
G_I = "① Impulzná sviečka"
impTF    = input.string("240", "Impulzný timeframe", options = ["Current", "15", "30", "60", "120", "180", "240", "D"], group = G_I, tooltip = "Timeframe, na ktorom sa hľadajú robustné sviečky. Current = timeframe grafu. Odporúčané: graf M15/H1 + impulz 240 (H4) alebo 60 (H1).")
robMode  = input.string("ATR násobok", "Robustnosť podľa", options = ["ATR násobok", "Percentil tiel", "Oboje (prísnejšie)"], group = G_I)
bodyMult = input.float(1.2, "Telo ≥ ATR ×", minval = 0.1, step = 0.1, group = G_I, inline = "r1", tooltip = "Telo sviečky (|close − open|) musí byť aspoň násobok ATR impulzného timeframe.")
atrLen   = input.int(14, "ATR dĺžka", minval = 2, group = G_I, inline = "r1")
bodyPct  = input.int(80, "Percentil tiel ≥", minval = 50, maxval = 99, group = G_I, inline = "r2", tooltip = "Telo musí byť v hornom percentile tiel za posledných N impulzných sviečok.")
pctLen   = input.int(100, "z N sviečok", minval = 20, maxval = 500, group = G_I, inline = "r2")
bodyRat  = input.float(0.55, "Telo / rozsah ≥", minval = 0.1, maxval = 1.0, step = 0.05, group = G_I, tooltip = "Podiel tela na celom rozsahu sviečky (high − low). Filtruje sviečky s dlhými knôtmi.")
minGap   = input.float(0.0, "Min. gap (USD)", minval = 0, step = 1, group = G_I, tooltip = "Minimálna veľkosť tela v cenových jednotkách. 0 = bez limitu.")
dirMode  = input.string("Iba býčie (buy the dip)", "Smer impulzov", options = ["Iba býčie (buy the dip)", "Iba medvedie (sell the rally)", "Oba smery"], group = G_I)
horizonH = input.float(168, "Horizont návratu (hodiny)", minval = 1, step = 1, group = G_I, tooltip = "Ak sa cena do tohto času nevráti na open impulzu, impulz sa uzavrie ako BEZ NÁVRATU. 168 h = 1 týždeň.")
deepWinH = input.float(24, "Okno pre hĺbku pod open po návrate (hodiny)", minval = 1, step = 1, group = G_I, tooltip = "Po návrate k open sa ešte toľko hodín sleduje, ako hlboko pod open cena išla (= možný návrat / očakávaný ponor pri buy the dip).")

G_M = "② MMA stack (Focus Touch MA … Last Barricade)"
maTF   = input.string("Current", "Timeframe línií", options = ["Current", "15", "30", "60", "120", "240", "D"], group = G_M, tooltip = "Timeframe pre všetkých šesť línií. Current = timeframe grafu.")
showM1 = input.bool(true, "Focus Touch MA", group = G_M, inline = "m1")
cM1    = input.color(#FFD54F, "", group = G_M, inline = "m1")
showM2 = input.bool(true, "Daily Tester MA", group = G_M, inline = "m2")
cM2    = input.color(#4FC3F7, "", group = G_M, inline = "m2")
showM3 = input.bool(true, "First Trend Tester", group = G_M, inline = "m3")
cM3    = input.color(#81C784, "", group = G_M, inline = "m3")
showM4 = input.bool(true, "Second Trend Tester", group = G_M, inline = "m4")
cM4    = input.color(#FFB74D, "", group = G_M, inline = "m4")
showM5 = input.bool(true, "Third Trend Tester", group = G_M, inline = "m5")
cM5    = input.color(#F06292, "", group = G_M, inline = "m5")
showM6 = input.bool(true, "Last Barricade", group = G_M, inline = "m6")
cM6    = input.color(#E0E0E0, "", group = G_M, inline = "m6")
showTch = input.bool(false, "Marker dotyku Focus Touch MA (✓/✗)", group = G_M, tooltip = "✓ = rozsah sviečky pokryl predchádzajúcu hodnotu Focus Touch MA, ✗ = nie. Dĺžka ✗ sérií vstupuje do Greed & Fear.")

G_P = "③ Potvrdenie pullbacku (otočka Focus Touch MA)"
confMode = input.string("Close pod/nad líniou", "Otočka =", options = ["Close pod/nad líniou", "Close + otočený sklon"], group = G_P, tooltip = "Býčí impulz: pullback je potvrdený, keď close zavrie POD Focus Touch MA (voliteľne aj sklon línie klesá). Medvedí impulz zrkadlovo.")
showTurn = input.bool(true, "Značka otočky na grafe", group = G_P)

G_S = "④ MS MODEL – generátor a spätný test signálov"
sigOn    = input.bool(true, "Generovať signály MS modelu", group = G_S)
reqTurn  = input.bool(true, "Vyžadovať otočku Focus Touch MA", group = G_S)
reqTrend = input.bool(true, "Trend filter: cena nad Last Barricade (BUY) / pod (SELL)", group = G_S)
gfMaxBuy = input.int(80, "BUY iba ak Greed & Fear ≤", minval = 0, maxval = 100, group = G_S, inline = "gf", tooltip = "Nekupovať pullback v extrémnej chamtivosti. SELL zrkadlovo: iba ak G&F ≥ 100 − hodnota.")
tolUSD   = input.float(2.0, "Tolerancia dotyku open (USD)", minval = 0, step = 0.5, group = G_S, inline = "tl")
tolATR   = input.float(0.15, "alebo ATR ×", minval = 0, step = 0.05, group = G_S, inline = "tl", tooltip = "Zóna okolo open impulzu = max(USD, ATR × násobok). Signál vzniká, keď sviečka zasiahne zónu a sú splnené filtre.")
tpUSD    = input.float(5.0, "TP modelu (USD)", minval = 0.1, step = 0.5, group = G_S, inline = "tp", tooltip = "Rovnaká logika ako GFX MS signály (typický TP ≈ 5 USD). Porovnanie v tabuľke MODEL vs GFX.")
sigTimeH = input.float(48, "Timeout signálu (hodiny)", minval = 1, group = G_S, inline = "tp")
showDip  = input.bool(true, "Kresliť očakávaný ponor pri signáli (GFX P50 / P75 / P90)", group = G_S)
sigSide  = input.string("Iba BUY", "Signály modelu", options = ["Iba BUY", "Oba smery"], group = G_S)

G_G = "⑤ Greed & Fear"
wRsi  = input.float(1.0, "Váha RSI", minval = 0, step = 0.5, group = G_G, inline = "w1")
wStr  = input.float(1.5, "Váha natiahnutia od Daily Tester", minval = 0, step = 0.5, group = G_G, inline = "w1")
wTr   = input.float(1.0, "Váha natiahnutia od First Trend Tester", minval = 0, step = 0.5, group = G_G, inline = "w2")
wMom  = input.float(1.0, "Váha momentum", minval = 0, step = 0.5, group = G_G, inline = "w2")
wRun  = input.float(1.0, "Váha série bez dotyku Focus Touch MA", minval = 0, step = 0.5, group = G_G, inline = "w3")
wBr   = input.float(0.5, "Váha šírky býčích sviečok", minval = 0, step = 0.5, group = G_G, inline = "w3")

G_X = "⑥ GFX MS 2026 dáta (interná štatistika)"
showGfx  = input.bool(true, "Značky GFX signálov na grafe", group = G_X)
matchTol = input.float(10.0, "GFX entry „sedí" na open impulzu ak |rozdiel| ≤ (USD)", minval = 0, step = 1, group = G_X, tooltip = "Meria, koľko reálnych GFX MS signálov bolo postnutých na úrovni open aktívneho impulzu (pullback level).")

G_V = "⑦ Vizuál a tabuľky"
maxDraw  = input.int(60, "Max. impulzov kreslených na grafe", minval = 5, maxval = 120, group = G_V)
maxSigD  = input.int(40, "Max. signálov modelu kreslených", minval = 5, maxval = 100, group = G_V)
lblSize  = input.string("small", "Veľkosť štítkov", options = ["tiny", "small", "normal"], group = G_V)
tblSize  = input.string("small", "Veľkosť tabuliek", options = ["tiny", "small", "normal"], group = G_V)
showT1   = input.bool(true, "Hlavná štatistika", group = G_V, inline = "t1")
posT1    = input.string("Vpravo hore", "", options = ["Vpravo hore", "Vpravo stred", "Vpravo dole", "Vľavo hore", "Vľavo stred", "Vľavo dole", "Stred hore", "Stred dole"], group = G_V, inline = "t1")
showT2   = input.bool(true, "Vplyv MA / bariér / G&F / session", group = G_V, inline = "t2")
posT2    = input.string("Vpravo dole", "", options = ["Vpravo hore", "Vpravo stred", "Vpravo dole", "Vľavo hore", "Vľavo stred", "Vľavo dole", "Stred hore", "Stred dole"], group = G_V, inline = "t2")
showT3   = input.bool(true, "Aktívne impulzy (živé)", group = G_V, inline = "t3")
posT3    = input.string("Vľavo dole", "", options = ["Vpravo hore", "Vpravo stred", "Vpravo dole", "Vľavo hore", "Vľavo stred", "Vľavo dole", "Stred hore", "Stred dole"], group = G_V, inline = "t3")
statSide = input.string("Oba", "Štatistika pre smer", options = ["Oba", "Iba BUY", "Iba SELL"], group = G_V)
minN     = input.int(8, "Min. počet vzoriek pre podmienenú pravdepodobnosť", minval = 1, group = G_V, tooltip = "Bunky s menším počtom vzoriek sú stlmené – štatisticky nespoľahlivé.")
tz       = input.string("Europe/Prague", "Časová zóna", group = G_V)
cBuy     = input.color(#26A69A, "Býčí impulz", group = G_V, inline = "c1")
cSell    = input.color(#EF5350, "Medvedí impulz", group = G_V, inline = "c1")
cFill    = input.color(#00C853, "Návrat ✓", group = G_V, inline = "c2")
cExp     = input.color(#78909C, "Bez návratu", group = G_V, inline = "c2")
cTurn    = input.color(#FFAB00, "Otočka Focus Touch MA", group = G_V, inline = "c3")
cSig     = input.color(#2979FF, "Signál modelu", group = G_V, inline = "c3")

